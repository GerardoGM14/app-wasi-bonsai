---
// PreguntasFrecuentes.astro — Sección de Preguntas frecuentes BonsaiPro
// Uso: import PreguntasFrecuentes from "../components/PreguntasFrecuentes.astro"; luego <PreguntasFrecuentes />

import { Image } from "astro:assets";
import iconP1 from "../assets/icons/icono_p1.svg";
import iconP2 from "../assets/icons/icono_p2.svg";
import iconP3 from "../assets/icons/icono_p3.svg";
import iconP4 from "../assets/icons/icono_p4.svg";
import iconP5 from "../assets/icons/icono_p5.svg";

export interface FaqItem {
  question: string;
  /** HTML del contenido de la respuesta */
  answer: string;
  icon?: any;
}

interface Props {
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  items?: FaqItem[];
}

const defaultItems: FaqItem[] = [
  {
    question: "¿Puedo usar BonsaiPro para otro tipo de plantas?",
    answer: `<p>¡Por supuesto! Bonsai Pro es ideal para cualquier planta en maceta que necesite un buen drenaje y aireación. Puedes usarlo con suculentas, cactus o plantas tropicales. Para plantas carnívoras debes utilizar musgo sphagnum.</p>`,
    icon: iconP1
  },
  {
    question: "¿Se puede mezclar BonsaiPro con otros materiales?",
    answer: `<p>Claro que sí. Bonsai Pro es una mezcla lista para usar, pero puedes ajustar las proporciones y adicionar otros materiales según tus necesidades de retención de agua o para cambiar el ph. Por ejemplo para plantas acidófilas puedes agregar un puñado de turba rubia por bolsa de BonsaiPro.</p>`,
    icon: iconP2
  },
  {
    question: "¿BonsaiPro es un producto sostenible?",
    answer: `<p>Asi es. BonsaiPro es un producto sostenible, elaborado con materiales naturales como roca volcánica, pómice y humus de lombriz, materiales naturales y duraderos que reducen el desperdicio y el impacto ambiental.</p>`,
    icon: iconP3
  },
  {
    question: "¿Cuánto tarda en llegar mi pedido?",
    answer: `<p>Los envios se realizan entre 24 y 48 horas desde la confirmación de tu pedido. ¡Hasta la puerta de casa!</p>`,
    icon: iconP4
  },
  {
    question: "¿Cómo puedo hacer mi pedido?",
    answer: `<p>Haz click en el boton “comprar”, completa el formulario con tu pedido y datos de envío. ¡Aprovecha la promoción espacial 3x2!</p>`,
    icon: iconP5
  }
];

const {
  eyebrow = "Preguntas frecuentes",
  title = "Resuelve tus dudas sobre",
  subtitle = "¿No encuentras lo que buscas? Escríbenos por WhatsApp y te respondemos al instante.",
  items = defaultItems
} = Astro.props as Props;
---

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Poppins:wght@500;600;700;800&family=Hanken+Grotesk:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap"
  rel="stylesheet"
/>

<section class="faq" aria-labelledby="faq-title">
  <div class="faq-inner">
    <div class="faq-eyebrow">
      <span class="faq-eyebrow-line"></span>
      <span class="faq-eyebrow-text">{eyebrow}</span>
    </div>

    <div class="faq-header">
      <div class="faq-heading-col">
        <h2 class="faq-title" id="faq-title">
          {title} <span class="faq-brand">BonsaiPro</span>
        </h2>
        <p class="faq-subtitle">{subtitle}</p>
      </div>
    </div>

    <div class="faq-list">
      {items.map((item, i) => (
        <div class="faq-item" data-question={item.question}>
          <button class="faq-q" type="button" aria-expanded="false">
            {item.icon ? (
              <Image src={item.icon} alt="" class="faq-num-img" />
            ) : (
              <span class="faq-num">{String(i + 1).padStart(2, "0")}</span>
            )}
            <span class="faq-q-text">{item.question}</span>
            <span class="faq-icon" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round">
                <path d="M12 5v14M5 12h14"></path>
              </svg>
            </span>
          </button>
          <div class="faq-a-wrap">
            <div class="faq-a-clip">
              <div class="faq-a" set:html={item.answer}></div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .faq {
    background: #E1D7D1; /* Adaptado a la paleta de color de fondo existente */
    font-family: "Hanken Grotesk", system-ui, sans-serif;
    padding: 76px 24px 92px;
    display: flex;
    justify-content: center;
  }
  .faq *,
  .faq *::before,
  .faq *::after { box-sizing: border-box; }

  .faq-inner { width: 100%; max-width: 1080px; }

  .faq-eyebrow {
    display: flex;
    align-items: center;
    gap: 9px;
    margin-bottom: 12px;
  }
  .faq-eyebrow-line { width: 26px; height: 2px; background: #a8701f; border-radius: 2px; }
  .faq-eyebrow-text {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #a8701f;
  }

  .faq-header {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 28px;
    margin-bottom: 40px;
  }
  .faq-heading-col { flex: 1; min-width: 320px; }

  .faq-title {
    font-family: 'Inter Tight', 'Inter', sans-serif;
    font-weight: 700;
    font-size: clamp(1.6rem, 2.2vw + 1rem, 2rem);
    line-height: 1.15;
    color: #3d2a18;
    margin: 0 0 14px;
    letter-spacing: -0.01em;
  }
  .faq-brand {
    color: #8B5000; /* Color exacto solicitado para el texto BonsaiPro */
  }
  .faq-subtitle {
    font-size: 16px;
    color: #8c7d6c;
    margin: 0;
    line-height: 1.55;
    max-width: 520px;
  }

  .faq-list { display: flex; flex-direction: column; gap: 14px; }

  .faq-item {
    background: #f4eee4;
    border: 1px solid rgba(120, 96, 70, 0.1);
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 1px 2px rgba(95, 74, 57, 0.04);
    transition: background 240ms cubic-bezier(0.16, 1, 0.3, 1),
      border-color 240ms, box-shadow 280ms;
  }
  .faq-item.open {
    background: #fbf7f0;
    border-color: rgba(207, 111, 31, 0.3);
    box-shadow: 0 16px 38px rgba(95, 74, 57, 0.12);
  }

  .faq-q {
    all: unset;
    box-sizing: border-box;
    cursor: pointer;
    width: 100%;
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 23px 26px;
  }
  .faq-num {
    flex: none;
    font-family: "Space Mono", monospace;
    font-weight: 700;
    font-size: 15px;
    width: 30px;
    color: #bda079;
    transition: color 240ms;
  }
  .faq-item.open .faq-num { color: #cf6f1f; }
  .faq-num-img {
    flex: none;
    width: 30px;
    height: 30px;
    object-fit: contain;
  }

  .faq-q-text {
    flex: 1;
    font-family: "Poppins", sans-serif;
    font-weight: 600;
    font-size: 16.5px;
    color: #36281c;
    text-align: left;
    letter-spacing: -0.2px;
  }

  .faq-icon {
    flex: none;
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: rgba(120, 96, 70, 0.1);
    color: #9a8268;
    transition: background 280ms, color 280ms,
      transform 360ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .faq-item.open .faq-icon {
    background: linear-gradient(135deg, #e89a2a, #cf6f1f);
    color: #fff7ec;
    transform: rotate(135deg);
  }

  .faq-a-wrap {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 380ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .faq-item.open .faq-a-wrap { grid-template-rows: 1fr; }
  .faq-a-clip { overflow: hidden; min-height: 0; }

  .faq-a {
    padding: 2px 30px 28px 80px;
    color: #897a6a;
    font-size: 15px;
    line-height: 1.65;
  }
  .faq-a :global(p) { margin: 0 0 18px; }
  .faq-a :global(p:last-child) { margin-bottom: 0; }

  .faq-spec {
    font-family: "Space Mono", monospace;
    background: #4a3a2c;
    border-radius: 12px;
    padding: 18px 22px;
    margin: 0 0 18px;
    color: #e8dccb;
    font-size: 13.5px;
    line-height: 2.05;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.04);
  }
  .faq-spec-head { color: #c79a5f; letter-spacing: 1px; }
  .faq-spec-blank { color: #8c7a64; letter-spacing: 2px; }
  .faq-spec-result { margin-top: 8px; color: #f0e7d8; }
  .faq-spec-result span { color: #e09a3a; }

  @media (max-width: 640px) {
    .faq { padding: 56px 18px 72px; }
    .faq-title { font-size: 30px; }
    .faq-a { padding-left: 26px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item,
    .faq-icon,
    .faq-a-wrap,
    .faq-num { transition: none; }
  }
</style>

<script>
  function initFaq(root: HTMLElement) {
    const items = Array.from(root.querySelectorAll<HTMLElement>(".faq-item"));

    items.forEach((item) => {
      const btn = item.querySelector<HTMLButtonElement>(".faq-q");
      btn?.addEventListener("click", () => {
        const isOpen = item.classList.contains("open");
        // Acordeón: cierra los demás
        items.forEach((other) => {
          other.classList.remove("open");
          other
            .querySelector(".faq-q")
            ?.setAttribute("aria-expanded", "false");
        });
        if (!isOpen) {
          item.classList.add("open");
          btn?.setAttribute("aria-expanded", "true");
        }
      });
    });
  }

  document
    .querySelectorAll<HTMLElement>(".faq")
    .forEach((el) => initFaq(el));
</script>
