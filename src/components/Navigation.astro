---
import { Image } from "astro:assets";
import logoWasi from "../assets/images/logo-wasibonsai.svg";
---

<nav class="fixed top-0 w-full z-50 px-6 py-4 bg-bar border-b border-white/5 shadow-lg">
    <div class="max-w-7xl mx-auto flex justify-between items-center">
        <a href="/" class="flex items-center transition-opacity hover:opacity-90">
            <Image
                src={logoWasi}
                alt="WasiBonsai Logo"
                class="h-8 md:h-10 w-auto"
            />
        </a>

        {/* Desktop Links */}
        <div class="hidden lg:flex gap-10 text-[15px] font-medium items-center text-asap-text">
            <a href="/#que-es" class="hover:text-white transition-colors duration-300 tracking-tight">¿Qué es BonsaiPro?</a>
            <a href="/#beneficios" class="hover:text-white transition-colors duration-300 tracking-tight">Beneficios de BonsaiPro</a>
            <a href="/#como-usar" class="hover:text-white transition-colors duration-300 tracking-tight">¿Cómo usar BonsaiPro?</a>
            <a href="/#clientes" class="hover:text-white transition-colors duration-300 tracking-tight">Nuestros clientes</a>
            <a href="/checkout" class="bg-comprar text-white px-6 md:px-8 py-2.5 rounded-full font-bold hover:-translate-y-1 hover:brightness-110 transition-all duration-300 cursor-pointer text-sm flex items-center gap-2 relative">
                <span>Carrito de compras</span>
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 0 0-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 0 0-16.536-1.84M7.5 14.25 5.106 5.272M6 20.25a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Zm12.75 0a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z" />
                </svg>
                <span class="nav-cart-badge hidden ml-1 bg-[#36281c] text-white text-[10px] font-bold rounded-full min-w-[20px] h-5 flex items-center justify-center border border-white/10 px-1.5">0</span>
            </a>
        </div>

        {/* Mobile Menu Trigger & Comprar Button */}
        <div class="flex lg:hidden items-center gap-4">
            <a href="/checkout" class="bg-comprar text-white px-4 py-1.5 rounded-full font-bold text-xs flex items-center gap-1.5 relative">
                <span>Carrito de compras</span>
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 0 0-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 0 0-16.536-1.84M7.5 14.25 5.106 5.272M6 20.25a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Zm12.75 0a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z" />
                </svg>
                <span class="nav-cart-badge hidden ml-1 bg-[#36281c] text-white text-[9px] font-bold rounded-full min-w-[16px] h-4 flex items-center justify-center border border-white/10 px-1">0</span>
            </a>
            <button id="menu-toggle" class="text-asap-text p-1" aria-label="Abrir menú">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-7 h-7">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"></path>
                </svg>
            </button>
        </div>
    </div>

    {/* Mobile Menu Overlay */}
    <div id="mobile-menu" class="hidden fixed inset-0 top-[70px] bg-bar/98 backdrop-blur-xl z-40 flex flex-col p-8 gap-8 text-xl font-bold text-asap-text items-center text-center animate-in fade-in slide-in-from-top-4 duration-300">
        <a href="/#que-es" class="menu-link border-b border-white/5 w-full pb-4">¿Qué es BonsaiPro?</a>
        <a href="/#beneficios" class="menu-link border-b border-white/5 w-full pb-4">Beneficios de BonsaiPro</a>
        <a href="/#como-usar" class="menu-link border-b border-white/5 w-full pb-4">¿Cómo usar BonsaiPro?</a>
        <a href="/#clientes" class="menu-link w-full pb-4">Nuestros clientes</a>
    </div>
</nav>

<script is:inline>
    const btn = document.getElementById("menu-toggle");
    const menu = document.getElementById("mobile-menu");
    const links = document.querySelectorAll(".menu-link");
    btn.onclick = () => menu.classList.toggle("hidden");
    links.forEach((l) => (l.onclick = () => menu.classList.add("hidden")));

    // Cart Badge logic
    window.updateNavBadge = function() {
        let cart = { promo: 1, unidad: 0 };
        try {
            const stored = localStorage.getItem("wasi-cart");
            if (stored) {
                cart = JSON.parse(stored);
            } else {
                localStorage.setItem("wasi-cart", JSON.stringify(cart));
            }
        } catch (e) {}

        const total = Object.values(cart).reduce((a, b) => a + b, 0);
        const badges = document.querySelectorAll(".nav-cart-badge");
        badges.forEach((badge) => {
            if (total > 0) {
                badge.textContent = String(total);
                badge.classList.remove("hidden");
            } else {
                badge.classList.add("hidden");
            }
        });
    };

    // Initial update
    window.updateNavBadge();
</script>

<style>
  .nav-cart-badge {
    transition: transform 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }
  .nav-cart-badge.pulse {
    transform: scale(1.4);
  }
</style>
