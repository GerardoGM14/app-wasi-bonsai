  interface CheckoutState {
    qty: Record<string, number>;
    ship: string;
    doc: string;
    pay: string;
    dep: string;
    prov: string;
    dist: string;
    open: string;
    [key: string]: any;
  }

  function initCheckout(root: HTMLElement) {
    // precios desde el markup
    const prices: Record<string, number> = {};
    root.querySelectorAll('.ck-item').forEach((item) => {
      const htmlItem = item as HTMLElement;
      const qtyEl = htmlItem.querySelector('[data-qty]') as HTMLElement;
      if (!qtyEl) return;
      const id = qtyEl.dataset.qty || '';
      const priceEl = htmlItem.querySelector('.ck-item-price');
      const txt = priceEl ? priceEl.textContent || '' : '';
      const m = txt.match(/(\d[\d.]*)/);
      prices[id] = m ? parseFloat(m[1]) : 0;
    });

    const money = (n: number) => 'S/. ' + n.toFixed(2);
    
    // Load qty from localStorage or initialize with default
    let storedCart: Record<string, number> = { promo: 1, unidad: 0 };
    try {
      const stored = localStorage.getItem('wasi-cart');
      if (stored) {
        storedCart = JSON.parse(stored);
      } else {
        localStorage.setItem('wasi-cart', JSON.stringify(storedCart));
      }
    } catch(err) {}

    const state: CheckoutState = { 
      qty: storedCart, 
      ship: 'delivery', 
      doc: 'boleta', 
      pay: 'yape', 
      dep: '', 
      prov: '', 
      dist: '', 
      open: '' 
    };
    
    root.querySelectorAll('[data-qty]').forEach((el) => {
      const htmlEl = el as HTMLElement;
      const id = htmlEl.dataset.qty || '';
      if (id && state.qty[id] !== undefined) {
        htmlEl.textContent = String(state.qty[id]);
      }
    });

    // ---- Totales ----
    function renderTotals() {
      let sub = 0, count = 0;
      Object.keys(state.qty).forEach((id) => {
        sub += (prices[id] || 0) * (state.qty[id] || 0);
        count += state.qty[id] || 0;
      });
      root.querySelectorAll('[data-qty]').forEach((el) => {
        const htmlEl = el as HTMLElement;
        htmlEl.textContent = String(state.qty[htmlEl.dataset.qty || ''] || 0);
      });
      const countEl = root.querySelector('[data-count]');
      if (countEl) countEl.textContent = String(count);
      const subEl = root.querySelector('[data-subtotal]');
      if (subEl) subEl.textContent = money(sub);
      root.querySelectorAll('[data-total]').forEach((el) => {
        el.textContent = money(sub);
      });
    }

    root.querySelectorAll('.ck-step-btn').forEach((btn) => {
      const htmlBtn = btn as HTMLElement;
      htmlBtn.addEventListener('click', () => {
        const id = htmlBtn.dataset.item || '';
        if (htmlBtn.dataset.act === 'inc') {
          state.qty[id] = (state.qty[id] || 0) + 1;
        } else {
          state.qty[id] = Math.max(0, (state.qty[id] || 0) - 1);
        }

        // Save to localStorage
        try {
          localStorage.setItem('wasi-cart', JSON.stringify(state.qty));
        } catch(err) {}

        // Update nav badge
        if (typeof (window as any).updateNavBadge === 'function') {
          (window as any).updateNavBadge();
        }

        renderTotals();
      });
    });

    // ---- Envío ----
    root.querySelectorAll('[data-ship]').forEach((btn) => {
      const htmlBtn = btn as HTMLElement;
      htmlBtn.addEventListener('click', () => {
        state.ship = htmlBtn.dataset.ship || '';
        root.querySelectorAll('[data-ship]').forEach((b) => b.classList.toggle('is-active', b === htmlBtn));
        const envio = root.querySelector('[data-envio]');
        if (envio) envio.textContent = state.ship === 'delivery' ? 'Gratis en Lima' : 'Por Shalom · por pagar';
      });
    });

    // ---- Comprobante ----
    root.querySelectorAll('[data-doc]').forEach((btn) => {
      const htmlBtn = btn as HTMLElement;
      htmlBtn.addEventListener('click', () => {
        state.doc = htmlBtn.dataset.doc || '';
        root.querySelectorAll('[data-doc]').forEach((b) => b.classList.toggle('is-active', b === htmlBtn));
        const lbl = root.querySelector('[data-doc-label]');
        const idLbl = root.querySelector('[data-doc-id-label]');
        if (lbl) lbl.innerHTML = (state.doc === 'factura' ? 'Razón social' : 'Nombre y apellido') + ' <span class="ck-req">*</span>';
        if (idLbl) idLbl.innerHTML = (state.doc === 'factura' ? 'RUC' : 'DNI') + ' <span class="ck-req">*</span>';

        // Adjust dynamic max length of doc-id input
        const docIdInput = root.querySelector('[data-field="doc-id"]') as HTMLInputElement;
        if (docIdInput) {
          const maxLen = state.doc === 'factura' ? 11 : 10;
          docIdInput.maxLength = maxLen;
          let val = docIdInput.value.replace(/\D/g, '');
          if (val.length > maxLen) {
            val = val.substring(0, maxLen);
          }
          docIdInput.value = val;
        }
      });
    });

    // ---- Pago ----
    root.querySelectorAll('[data-pay]').forEach((btn) => {
      const htmlBtn = btn as HTMLElement;
      htmlBtn.addEventListener('click', () => {
        state.pay = htmlBtn.dataset.pay || '';
        root.querySelectorAll('[data-pay]').forEach((b) => b.classList.toggle('is-active', b === htmlBtn));
        root.querySelectorAll('[data-info]').forEach((el) => {
          const htmlEl = el as HTMLElement;
          htmlEl.hidden = htmlEl.dataset.info !== state.pay;
        });
        const qr = root.querySelector('[data-qr]') as HTMLElement;
        if (qr) qr.hidden = state.pay !== 'yape';
      });
    });

    // ---- Dropdowns en cascada ----
    const dds: Record<string, HTMLElement> = {};
    root.querySelectorAll('[data-dd]').forEach((dd) => {
      const htmlDd = dd as HTMLElement;
      dds[htmlDd.dataset.dd || ''] = htmlDd;
    });

    function optionsFor(which: string): string[] {
      if (which === 'dep') return Object.keys(PERU);
      if (which === 'prov') return state.dep ? Object.keys(PERU[state.dep as keyof typeof PERU]) : [];
      if (which === 'dist') {
        const depData = PERU[state.dep as keyof typeof PERU];
        return (state.dep && state.prov && depData && depData[state.prov as keyof typeof depData])
          ? depData[state.prov as keyof typeof depData]
          : [];
      }
      return [];
    }

    function placeholderFor(which: string): string {
      if (which === 'dep') return 'Selecciona departamento';
      if (which === 'prov') return state.dep ? 'Selecciona provincia' : 'Elige departamento';
      return state.prov ? 'Selecciona distrito' : 'Elige provincia';
    }

    function pick(which: string, value: string) {
      if (which === 'dep') { state.dep = value; state.prov = ''; state.dist = ''; }
      else if (which === 'prov') { state.prov = value; state.dist = ''; }
      else { state.dist = value; }
      state.open = '';
      renderDD();
    }

    function renderDD() {
      ['dep', 'prov', 'dist'].forEach((which) => {
        const dd = dds[which];
        if (!dd) return;
        const enabled = which === 'dep' || (which === 'prov' && !!state.dep) || (which === 'dist' && !!state.prov);
        const selected = state[which];
        const valueEl = dd.querySelector('.ck-dd-value') as HTMLElement;
        const panel = dd.querySelector('.ck-dd-panel') as HTMLElement;
        if (!valueEl || !panel) return;

        dd.classList.toggle('is-disabled', !enabled);
        dd.classList.toggle('is-open', state.open === which && enabled);

        if (selected) {
          valueEl.textContent = selected;
          valueEl.classList.remove('is-placeholder');
        } else {
          valueEl.textContent = placeholderFor(which);
          valueEl.classList.add('is-placeholder');
        }

        panel.innerHTML = '';
        optionsFor(which).forEach((opt) => {
          const b = document.createElement('button');
          b.type = 'button';
          b.className = 'ck-dd-opt' + (opt === selected ? ' is-selected' : '');
          b.textContent = opt;
          b.addEventListener('click', (e) => { e.stopPropagation(); pick(which, opt); });
          panel.appendChild(b);
        });
      });
    }

    root.querySelectorAll('[data-dd] .ck-dd-trigger').forEach((trigger) => {
      const htmlTrigger = trigger as HTMLElement;
      htmlTrigger.addEventListener('click', (e) => {
        e.stopPropagation();
        const ddParent = htmlTrigger.closest('[data-dd]') as HTMLElement;
        if (!ddParent) return;
        const which = ddParent.dataset.dd || '';
        const enabled = which === 'dep' || (which === 'prov' && !!state.dep) || (which === 'dist' && !!state.prov);
        if (!enabled) return;
        state.open = state.open === which ? '' : which;
        renderDD();
      });
    });

    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (state.open && target && (!target.closest || !target.closest('[data-dd]'))) {
        state.open = '';
        renderDD();
      }
    });

    // ---- QR Modal ----
    const qrTrigger = root.querySelector('[data-qr]') as HTMLElement;
    const qrModal = root.querySelector('#qr-modal') as HTMLElement;
    const qrClose = root.querySelector('#close-qr-modal') as HTMLElement;

    if (qrTrigger && qrModal && qrClose) {
      qrTrigger.addEventListener('click', () => {
        qrModal.hidden = false;
        qrModal.classList.remove('is-closing');
      });

      const closeModal = () => {
        qrModal.classList.add('is-closing');
        setTimeout(() => {
          qrModal.hidden = true;
          qrModal.classList.remove('is-closing');
        }, 200);
      };

      qrClose.addEventListener('click', (e) => {
        e.stopPropagation();
        closeModal();
      });

      qrModal.addEventListener('click', (e) => {
        if (e.target === qrModal) {
          closeModal();
        }
      });
    }

    // ---- Toast alerts ----
    function showToast(message: string, type: 'error' | 'success' = 'error') {
      const toast = root.querySelector('#validation-toast') as HTMLElement;
      if (!toast) return;
      toast.textContent = message;
      toast.className = 'ck-toast' + (type === 'success' ? ' success' : '');
      toast.classList.remove('hidden');
      
      if ((window as any).toastTimeout) {
        clearTimeout((window as any).toastTimeout);
      }
      (window as any).toastTimeout = setTimeout(() => {
        toast.classList.add('hidden');
      }, 3500);
    }

    const toastEl = root.querySelector('#validation-toast') as HTMLElement;
    if (toastEl) {
      toastEl.addEventListener('click', () => toastEl.classList.add('hidden'));
    }

    // ---- Clear validation on input ----
    root.querySelectorAll('.ck-input').forEach((input) => {
      const htmlInput = input as HTMLInputElement;
      htmlInput.addEventListener('input', () => {
        htmlInput.classList.remove('is-invalid');
      });
    });

    // Remove is-invalid from dropdown when selected
    const ddsKeys = ['dep', 'prov', 'dist'];
    ddsKeys.forEach((key) => {
      const dd = dds[key];
      if (dd) {
        dd.addEventListener('click', () => {
          dd.classList.remove('is-invalid');
        });
      }
    });

    // ---- Comprobante Attach File Handler (Modal + Drag and Drop) ----
    const fileInput = root.querySelector('#comprobante-file') as HTMLInputElement;
    const attachBtn = root.querySelector('#ck-attach-btn') as HTMLButtonElement;
    const attachText = root.querySelector('#ck-attach-text') as HTMLElement;
    
    const receiptModal = root.querySelector('#receipt-modal') as HTMLElement;
    const closeReceiptBtn = root.querySelector('#close-receipt-modal') as HTMLElement;
    const cancelReceiptBtn = root.querySelector('#cancel-receipt-btn') as HTMLElement;
    const confirmReceiptBtn = root.querySelector('#confirm-receipt-btn') as HTMLElement;
    const dropzone = root.querySelector('#receipt-dropzone') as HTMLElement;
    const dropzoneEmpty = root.querySelector('#dropzone-empty') as HTMLElement;
    const dropzoneFilled = root.querySelector('#dropzone-filled') as HTMLElement;
    const attachedFileName = root.querySelector('#attached-file-name') as HTMLElement;
    const removeFileBtn = root.querySelector('#remove-file-btn') as HTMLElement;

    let confirmedFile: File | null = null;
    let tempFile: File | null = null;

    function syncModalUI() {
      if (tempFile) {
        if (dropzoneEmpty) dropzoneEmpty.hidden = true;
        if (dropzoneFilled) dropzoneFilled.hidden = false;
        if (attachedFileName) attachedFileName.textContent = tempFile.name;
      } else {
        if (dropzoneEmpty) dropzoneEmpty.hidden = false;
        if (dropzoneFilled) dropzoneFilled.hidden = true;
        if (attachedFileName) attachedFileName.textContent = '';
      }
    }

    const closeReceiptModal = () => {
      if (receiptModal) {
        receiptModal.classList.add('is-closing');
        setTimeout(() => {
          receiptModal.hidden = true;
          receiptModal.classList.remove('is-closing');
        }, 200);
      }
    };

    if (attachBtn && receiptModal) {
      attachBtn.addEventListener('click', () => {
        tempFile = confirmedFile;
        syncModalUI();
        receiptModal.hidden = false;
        receiptModal.classList.remove('is-closing');
      });
    }

    if (closeReceiptBtn) {
      closeReceiptBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        closeReceiptModal();
      });
    }

    if (cancelReceiptBtn) {
      cancelReceiptBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        closeReceiptModal();
      });
    }

    if (receiptModal) {
      receiptModal.addEventListener('click', (e) => {
        if (e.target === receiptModal) {
          closeReceiptModal();
        }
      });
    }

    if (dropzone && fileInput) {
      dropzone.addEventListener('click', (e) => {
        if (e.target === removeFileBtn) return;
        fileInput.click();
      });

      // Drag and drop events
      ['dragenter', 'dragover'].forEach(eventName => {
        dropzone.addEventListener(eventName, (e) => {
          e.preventDefault();
          e.stopPropagation();
          dropzone.classList.add('is-dragover');
        }, false);
      });

      ['dragleave', 'drop'].forEach(eventName => {
        dropzone.addEventListener(eventName, (e) => {
          e.preventDefault();
          e.stopPropagation();
          dropzone.classList.remove('is-dragover');
        }, false);
      });

      dropzone.addEventListener('drop', (e) => {
        const dt = e.dataTransfer;
        const files = dt?.files;
        if (files && files.length > 0) {
          tempFile = files[0];
          syncModalUI();
        }
      }, false);
    }

    if (fileInput) {
      fileInput.addEventListener('change', () => {
        if (fileInput.files && fileInput.files.length > 0) {
          tempFile = fileInput.files[0];
          syncModalUI();
        }
      });
    }

    if (removeFileBtn) {
      removeFileBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        tempFile = null;
        if (fileInput) fileInput.value = '';
        syncModalUI();
      });
    }

    if (confirmReceiptBtn) {
      confirmReceiptBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        confirmedFile = tempFile;
        
        // Update parent button state
        if (confirmedFile) {
          if (attachText) attachText.textContent = `Comprobante: ${confirmedFile.name}`;
          attachBtn?.classList.add('is-attached');
          attachBtn?.classList.remove('is-invalid');
        } else {
          if (attachText) attachText.textContent = 'Adjuntar comprobante';
          attachBtn?.classList.remove('is-attached');
        }
        
        closeReceiptModal();
      });
    }

    // ---- Celular restriction: digits only, max 9, starts with 9 ----
    const celularInput = root.querySelector('[data-field="celular"]') as HTMLInputElement;
    if (celularInput) {
      celularInput.addEventListener('input', () => {
        let val = celularInput.value.replace(/\D/g, ''); // strip non-digits
        if (val.length > 9) {
          val = val.substring(0, 9);
        }
        celularInput.value = val;
      });
    }

    // ---- DNI / CE restriction: digits only, max 10 ----
    const dniInput = root.querySelector('[data-field="dni"]') as HTMLInputElement;
    if (dniInput) {
      dniInput.addEventListener('input', () => {
        let val = dniInput.value.replace(/\D/g, ''); // strip non-digits
        if (val.length > 10) {
          val = val.substring(0, 10);
        }
        dniInput.value = val;
      });
    }

    // ---- Comprobante Doc ID restriction: digits only, dynamic max length ----
    const docIdInput = root.querySelector('[data-field="doc-id"]') as HTMLInputElement;
    if (docIdInput) {
      docIdInput.addEventListener('input', () => {
        let val = docIdInput.value.replace(/\D/g, ''); // strip non-digits
        const maxLen = state.doc === 'factura' ? 11 : 10;
        if (val.length > maxLen) {
          val = val.substring(0, maxLen);
        }
        docIdInput.value = val;
      });
    }

    // ---- Send WhatsApp Order ----
    function sendWhatsAppOrder() {
      const nombre = (root.querySelector('[data-field="nombre"]') as HTMLInputElement)?.value || '';
      const dni = (root.querySelector('[data-field="dni"]') as HTMLInputElement)?.value || '';
      const correo = (root.querySelector('[data-field="correo"]') as HTMLInputElement)?.value || '';
      const celular = (root.querySelector('[data-field="celular"]') as HTMLInputElement)?.value || '';
      const docNombre = (root.querySelector('[data-field="doc-nombre"]') as HTMLInputElement)?.value || '';
      const docId = (root.querySelector('[data-field="doc-id"]') as HTMLInputElement)?.value || '';

      const itemsText = Object.keys(state.qty)
        .filter(id => state.qty[id] > 0)
        .map(id => {
          const name = id === 'promo' ? 'Promo 3x2' : 'Unidad Bonsai Pro';
          return `- ${name}: ${state.qty[id]} u.`;
        })
        .join('\n');

      const text = `*Nuevo Pedido Wasi Bonsai*\n\n` +
        `*Detalle del pedido:*\n${itemsText}\n\n` +
        `*Datos de entrega:*\n` +
        `- Departamento: ${state.dep}\n` +
        `- Provincia: ${state.prov}\n` +
        `- Distrito: ${state.dist}\n` +
        `- Nombre: ${nombre}\n` +
        `- DNI / CE: ${dni}\n` +
        `- Correo: ${correo}\n` +
        `- Celular: ${celular}\n\n` +
        `*Comprobante (${state.doc === 'factura' ? 'Factura' : 'Boleta'}):*\n` +
        `- ${state.doc === 'factura' ? 'Razón Social' : 'Nombre'}: ${docNombre}\n` +
        `- ${state.doc === 'factura' ? 'RUC' : 'DNI'}: ${docId}\n\n` +
        `*Método de Pago:*\n- ${state.pay === 'yape' ? 'Yape / Plin' : 'Transferencia BCP'}`;

      const phone = "51918574506"; // Wasi Bonsai business number
      const url = `https://api.whatsapp.com/send?phone=${phone}&text=${encodeURIComponent(text)}`;
      window.open(url, '_blank');
    }

    // Helper to read file as Base64 data URL
    function fileToBase64(file: File): Promise<string> {
      return new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.readAsDataURL(file);
        reader.onload = () => resolve(reader.result as string);
        reader.onerror = error => reject(error);
      });
    }

    // Send emails using EmailJS REST API
    async function sendEmails(params: any) {
      if (!EMAILJS_CONFIG.PUBLIC_KEY || EMAILJS_CONFIG.PUBLIC_KEY === 'TU_PUBLIC_KEY') {
        console.log('EmailJS no está configurado. Saltando envío de correos.');
        return;
      }

      // 1. Enviar correo al cliente
      if (EMAILJS_CONFIG.TEMPLATE_CLIENTE && EMAILJS_CONFIG.TEMPLATE_CLIENTE !== 'TU_TEMPLATE_CLIENTE_ID') {
        try {
          await fetch('https://api.emailjs.com/api/v1.0/email/send', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              service_id: EMAILJS_CONFIG.SERVICE_ID,
              template_id: EMAILJS_CONFIG.TEMPLATE_CLIENTE,
              user_id: EMAILJS_CONFIG.PUBLIC_KEY,
              template_params: params
            })
          });
          console.log('Correo de confirmación enviado al cliente con éxito.');
        } catch (err) {
          console.error('Error al enviar correo al cliente:', err);
        }
      }

      // 2. Enviar correo a la empresa (alerta de venta)
      if (EMAILJS_CONFIG.TEMPLATE_EMPRESA && EMAILJS_CONFIG.TEMPLATE_EMPRESA !== 'TU_TEMPLATE_EMPRESA_ID') {
        try {
          await fetch('https://api.emailjs.com/api/v1.0/email/send', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              service_id: EMAILJS_CONFIG.SERVICE_ID,
              template_id: EMAILJS_CONFIG.TEMPLATE_EMPRESA,
              user_id: EMAILJS_CONFIG.PUBLIC_KEY,
              template_params: params
            })
          });
          console.log('Correo de alerta enviado a la empresa con éxito.');
        } catch (err) {
          console.error('Error al enviar alerta a la empresa:', err);
        }
      }
    }

    // ---- Submit Button Validation ----
    const buyBtn = root.querySelector('.ck-buy') as HTMLElement;
    if (buyBtn) {
      buyBtn.addEventListener('click', async (e) => {
        e.preventDefault();

        // Reset previous validation borders
        root.querySelectorAll('.is-invalid').forEach((el) => el.classList.remove('is-invalid'));

        let isValid = true;
        let errMsg = '';

        // 1. Validate cascade location dropdowns
        if (!state.dep) {
          dds['dep']?.classList.add('is-invalid');
          if (isValid) { errMsg = 'Por favor, selecciona un departamento.'; isValid = false; }
        }
        if (state.dep && !state.prov) {
          dds['prov']?.classList.add('is-invalid');
          if (isValid) { errMsg = 'Por favor, selecciona una provincia.'; isValid = false; }
        }
        if (state.prov && !state.dist) {
          dds['dist']?.classList.add('is-invalid');
          if (isValid) { errMsg = 'Por favor, selecciona un distrito.'; isValid = false; }
        }

        // 2. Validate personal info
        const nombreInput = root.querySelector('[data-field="nombre"]') as HTMLInputElement;
        const dniInput = root.querySelector('[data-field="dni"]') as HTMLInputElement;
        const correoInput = root.querySelector('[data-field="correo"]') as HTMLInputElement;
        const celularInput = root.querySelector('[data-field="celular"]') as HTMLInputElement;

        if (nombreInput && !nombreInput.value.trim()) {
          nombreInput.classList.add('is-invalid');
          if (isValid) { errMsg = 'Por favor, ingresa tu nombre y apellido.'; isValid = false; }
        }
        if (dniInput) {
          const val = dniInput.value.trim();
          if (!val) {
            dniInput.classList.add('is-invalid');
            if (isValid) { errMsg = 'Por favor, ingresa tu DNI / CE.'; isValid = false; }
          } else if (val.length < 8 || val.length > 10) {
            dniInput.classList.add('is-invalid');
            if (isValid) { errMsg = 'El DNI / CE debe tener entre 8 y 10 dígitos.'; isValid = false; }
          }
        }
        if (correoInput) {
          const val = correoInput.value.trim();
          if (!val) {
            correoInput.classList.add('is-invalid');
            if (isValid) { errMsg = 'Por favor, ingresa tu correo.'; isValid = false; }
          } else if (!val.includes('@')) {
            correoInput.classList.add('is-invalid');
            if (isValid) { errMsg = 'El correo electrónico debe contener "@".'; isValid = false; }
          }
        }
        if (celularInput) {
          const val = celularInput.value.trim();
          if (!val) {
            celularInput.classList.add('is-invalid');
            if (isValid) { errMsg = 'Por favor, ingresa tu número de celular.'; isValid = false; }
          } else if (val.length !== 9 || !val.startsWith('9')) {
            celularInput.classList.add('is-invalid');
            if (isValid) { errMsg = 'El celular debe tener exactamente 9 dígitos y empezar con 9.'; isValid = false; }
          }
        }

        // 3. Validate comprobante info
        const docNombreInput = root.querySelector('[data-field="doc-nombre"]') as HTMLInputElement;
        const docIdInput = root.querySelector('[data-field="doc-id"]') as HTMLInputElement;

        if (docNombreInput && !docNombreInput.value.trim()) {
          docNombreInput.classList.add('is-invalid');
          if (isValid) {
            errMsg = state.doc === 'factura'
              ? 'Por favor, ingresa la razón social para la factura.'
              : 'Por favor, ingresa tu nombre y apellido para la boleta.';
            isValid = false;
          }
        }
        if (docIdInput) {
          const val = docIdInput.value.trim();
          if (!val) {
            docIdInput.classList.add('is-invalid');
            if (isValid) {
              errMsg = state.doc === 'factura'
                ? 'Por favor, ingresa el RUC para la factura.'
                : 'Por favor, ingresa el DNI para la boleta.';
              isValid = false;
            }
          } else if (state.doc === 'factura' && val.length !== 11) {
            docIdInput.classList.add('is-invalid');
            if (isValid) {
              errMsg = 'El RUC debe tener exactamente 11 dígitos.';
              isValid = false;
            }
          } else if (state.doc === 'boleta' && (val.length < 8 || val.length > 10)) {
            docIdInput.classList.add('is-invalid');
            if (isValid) {
              errMsg = 'El DNI o CE para la boleta debe tener entre 8 y 10 dígitos.';
              isValid = false;
            }
          }
        }

        // 4. Validate payment proof attachment
        if (!confirmedFile) {
          attachBtn?.classList.add('is-invalid');
          if (isValid) {
            errMsg = 'Por favor, adjunta tu comprobante de pago.';
            isValid = false;
          }
        }

        if (!isValid) {
          showToast(errMsg, 'error');
          return;
        }

        showToast('Procesando pedido...', 'success');

        // Compile email template parameters
        let base64File = '';
        try {
          if (confirmedFile) {
            base64File = await fileToBase64(confirmedFile);
          }
        } catch (err) {
          console.error('Error al convertir comprobante a base64:', err);
        }

        const itemsText = Object.keys(state.qty)
          .filter(id => state.qty[id] > 0)
          .map(id => {
            const name = id === 'promo' ? 'Promo 3x2' : 'Unidad Bonsai Pro';
            return `- ${name}: ${state.qty[id]} u.`;
          })
          .join('\n');

        const params = {
          nombre: nombreInput.value.trim(),
          dni: dniInput.value.trim(),
          correo: correoInput.value.trim(),
          celular: celularInput.value.trim(),
          ubigeo: `${state.dep} → ${state.prov} → ${state.dist}`,
          pedido: itemsText,
          metodo_pago: state.pay === 'yape' ? 'Yape / Plin' : 'Transferencia BCP',
          tipo_comprobante: state.doc === 'factura' ? 'Factura' : 'Boleta',
          comprobante_datos: state.doc === 'factura'
            ? `Razón Social: ${docNombreInput.value.trim()} | RUC: ${docIdInput.value.trim()}`
            : `Nombre: ${docNombreInput.value.trim()} | DNI: ${docIdInput.value.trim()}`,
          comprobante: base64File
        };

        // Clear cart in state & localStorage
        state.qty = { promo: 0, unidad: 0 };
        try {
          localStorage.setItem('wasi-cart', JSON.stringify(state.qty));
        } catch (err) {}

        // Update nav badge
        if (typeof (window as any).updateNavBadge === 'function') {
          (window as any).updateNavBadge();
        }

        // Trigger emails in background and redirect
        sendEmails(params).then(() => {
          sendWhatsAppOrder();
          window.location.href = '/gracias';
        });
      });
    }

    renderTotals();
    renderDD();
  }

  document.querySelectorAll('.ck-page').forEach((el) => initCheckout(el as HTMLElement));
</script>
