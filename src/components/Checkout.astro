---
// Checkout.astro — Vista "Finaliza tu compra" Wasi Bonsai / BonsaiPro
// Uso: import Checkout from "../components/Checkout.astro"; luego <Checkout />
//
// Fuentes: carga Poppins, Hanken Grotesk y Space Mono desde Google Fonts.
// Si ya las cargas en tu Layout, borra el bloque <link> de abajo.
//
// Incluye: steppers de cantidad con total en vivo, envío/comprobante
// segmentados, dropdowns en cascada con ubigeo real del Perú
// (departamento → provincia → distrito) y selector de método de pago.
// Los datos de pago y el formulario son de ejemplo — conéctalos a tu backend.

interface Producto {
  id: string;
  nombre: string;
  precio: number;
  cantidad: number;
}

interface Props {
  productos?: Producto[];
  yapeNumero?: string;
  yapeTitular?: string;
  cuentaBcp?: string;
  cciBcp?: string;
}

const {
  productos = [
    { id: "promo", nombre: "Promo 3x2", precio: 38, cantidad: 1 },
    { id: "unidad", nombre: "Unidad Bonsai Pro", precio: 20, cantidad: 0 }
  ],
  yapeNumero = "918 574 506",
  yapeTitular = "Jesús Francisco Iparraguirre Moreno",
  cuentaBcp = "191 2345678 0 99",
  cciBcp = "CCI 002 191 002345678099 · Wasi Bonsai"
} = Astro.props as Props;

const money = (n: number) => "S/. " + n.toFixed(2);
const subtotal = productos.reduce((a, p) => a + p.precio * p.cantidad, 0);
const itemCount = productos.reduce((a, p) => a + p.cantidad, 0);
---

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Poppins:wght@500;600;700;800&family=Hanken+Grotesk:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap"
  rel="stylesheet"
/>

<div class="ck-page">
  <div class="ck-card">
    <!-- Header -->
    <div class="ck-header">
      <h1 class="ck-h1">Finaliza tu compra</h1>
      <p class="ck-sub">Revisa tu pedido, completa tus datos y adjunta tu comprobante de pago.</p>
    </div>

    <!-- Body -->
    <div class="ck-body">
      <!-- Cart -->
      <div class="ck-cart">
        <div class="ck-section-label">Tu pedido</div>

        <div class="ck-items">
          {productos.map((p) => (
            <div class="ck-item">
              <div class="ck-thumb">
                <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 8h14l-1.5 11.5a1 1 0 0 1-1 .9H7.5a1 1 0 0 1-1-.9L5 8z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg>
              </div>
              <div class="ck-item-info">
                <div class="ck-item-name">{p.nombre}</div>
                <div class="ck-item-price">{money(p.precio)} c/u</div>
              </div>
              <div class="ck-stepper">
                <button type="button" class="ck-step-btn ck-step-minus" data-act="dec" data-item={p.id} aria-label="Menos">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M5 12h14"/></svg>
                </button>
                <span class="ck-qty" data-qty={p.id}>{p.cantidad}</span>
                <button type="button" class="ck-step-btn ck-step-plus" data-act="inc" data-item={p.id} aria-label="Más">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
                </button>
              </div>
            </div>
          ))}
        </div>

        <!-- Summary -->
        <div class="ck-summary">
          <div class="ck-sum-row">
            <span>Subtotal · <span class="ck-mono" data-count>{itemCount}</span> artículos</span>
            <span class="ck-mono ck-strong" data-subtotal>{money(subtotal)}</span>
          </div>
          <div class="ck-sum-row">
            <span>Envío</span>
            <span class="ck-envio" data-envio>Gratis en Lima</span>
          </div>
          <div class="ck-total-row">
            <div>
              <div class="ck-total-label">Total</div>
              <div class="ck-total-igv">Incluye IGV</div>
            </div>
            <span class="ck-total-amt" data-total>{money(subtotal)}</span>
          </div>
        </div>
      </div>

      <!-- Form -->
      <div class="ck-form">
        <h2 class="ck-h2">Datos de entrega</h2>
        <p class="ck-form-note">Este formulario se reenviará a tu WhatsApp junto a tu comprobante de pago para coordinar el horario de entrega y los detalles de tu pedido.</p>

        <!-- Envío -->
        <div class="ck-block">
          <span class="ck-label">Tipo de envío <span class="ck-req">*</span></span>
          <div class="ck-seg">
            <button type="button" class="ck-seg-btn is-active" data-ship="delivery">Delivery (Solo Lima)</button>
            <button type="button" class="ck-seg-btn" data-ship="provincia">A provincia (Por Shalom)</button>
          </div>
        </div>

        <!-- Ubicación · cascada Perú -->
        <div class="ck-grid-3">
          <div class="ck-dd" data-dd="dep">
            <span class="ck-label">Departamento <span class="ck-req">*</span></span>
            <button type="button" class="ck-dd-trigger">
              <span class="ck-dd-value is-placeholder">Selecciona departamento</span>
              <svg class="ck-dd-chev" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#a8957f" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
            </button>
            <div class="ck-dd-panel"></div>
          </div>

          <div class="ck-dd is-disabled" data-dd="prov">
            <span class="ck-label">Provincia <span class="ck-req">*</span></span>
            <button type="button" class="ck-dd-trigger">
              <span class="ck-dd-value is-placeholder">Elige departamento</span>
              <svg class="ck-dd-chev" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#a8957f" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
            </button>
            <div class="ck-dd-panel"></div>
          </div>

          <div class="ck-dd is-disabled" data-dd="dist">
            <span class="ck-label">Distrito <span class="ck-req">*</span></span>
            <button type="button" class="ck-dd-trigger">
              <span class="ck-dd-value is-placeholder">Elige provincia</span>
              <svg class="ck-dd-chev" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#a8957f" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
            </button>
            <div class="ck-dd-panel"></div>
          </div>
        </div>

        <!-- Nombre / DNI -->
        <div class="ck-grid-2">
          <label class="ck-field">
            <span class="ck-label">Nombre y apellido <span class="ck-req">*</span></span>
            <input type="text" class="ck-input" placeholder="Tu nombre completo" />
          </label>
          <label class="ck-field">
            <span class="ck-label">DNI / CE <span class="ck-req">*</span></span>
            <input type="text" class="ck-input" placeholder="00000000" />
          </label>
        </div>

        <!-- Correo / Celular -->
        <div class="ck-grid-2 ck-mb-lg">
          <label class="ck-field">
            <span class="ck-label">Correo <span class="ck-req">*</span></span>
            <input type="email" class="ck-input" placeholder="tucorreo@gmail.com" />
          </label>
          <label class="ck-field">
            <span class="ck-label">Celular <span class="ck-req">*</span></span>
            <input type="tel" class="ck-input" placeholder="9 dígitos" />
          </label>
        </div>

        <!-- Comprobante -->
        <div class="ck-comprobante">
          <span class="ck-label">Comprobante</span>
          <div class="ck-seg ck-mb-md">
            <button type="button" class="ck-seg-btn is-active ck-seg-wide" data-doc="boleta">Boleta</button>
            <button type="button" class="ck-seg-btn ck-seg-wide" data-doc="factura">Factura</button>
          </div>
          <div class="ck-grid-2">
            <label class="ck-field">
              <span class="ck-label" data-doc-label>Nombre y apellido <span class="ck-req">*</span></span>
              <input type="text" class="ck-input" />
            </label>
            <label class="ck-field">
              <span class="ck-label" data-doc-id-label>DNI <span class="ck-req">*</span></span>
              <input type="text" class="ck-input" />
            </label>
          </div>
          <div class="ck-obligatorio">* Dato obligatorio</div>
        </div>
      </div>

      <!-- Payment -->
      <div class="ck-payment">
        <div class="ck-section-label">Pago y Comprobante</div>

        <div class="ck-foot-head">
          <span class="ck-foot-title">Adjunta tu comprobante de pago</span>
          <span class="ck-foot-total" data-total>{money(subtotal)}</span>
        </div>

        <div class="ck-pay">
          <!-- Method selector -->
          <div class="ck-pay-methods">
            <button type="button" class="ck-pay-method is-active" data-pay="yape">
              <span class="ck-radio"><span class="ck-radio-dot"></span></span>
              <span class="ck-pay-name">Yape / Plin</span>
            </button>
            <button type="button" class="ck-pay-method" data-pay="transfer">
              <span class="ck-radio"><span class="ck-radio-dot"></span></span>
              <span class="ck-pay-name">Transferencia</span>
            </button>
          </div>

          <!-- Info panel -->
          <div class="ck-info">
            <div class="ck-info-text">
              <div class="ck-info-block" data-info="yape">
                <div class="ck-info-eyebrow">Yape / Plin</div>
                <div class="ck-info-main">{yapeNumero}</div>
                <div class="ck-info-sub">{yapeTitular}</div>
              </div>
              <div class="ck-info-block" data-info="transfer" hidden>
                <div class="ck-info-eyebrow">Cuenta BCP · Soles</div>
                <div class="ck-info-main">{cuentaBcp}</div>
                <div class="ck-info-sub">{cciBcp}</div>
              </div>
            </div>
            <div class="ck-qr" data-qr>
              <svg width="58" height="58" viewBox="0 0 24 24" fill="none" stroke="#6f5e4c" stroke-width="1.4"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><path d="M14 14h3v3M20 14v.01M14 20h.01M17 20h.01M20 17v4" stroke-linecap="round"/></svg>
            </div>
          </div>

          <!-- Actions -->
          <div class="ck-actions">
            <button type="button" class="ck-attach">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="m21.44 11.05-9.19 9.19a6 6 0 0 1-8.49-8.49l8.57-8.57A4 4 0 1 1 18 8.84l-8.59 8.57a2 2 0 0 1-2.83-2.83l8.49-8.48"/></svg>
              Adjuntar comprobante
            </button>
            <button type="button" class="ck-buy">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="21" r="1"/><circle cx="19" cy="21" r="1"/><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"/></svg>
              Comprar ahora
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .ck-page { background: #e7ddcf; font-family: "Hanken Grotesk", system-ui, sans-serif; padding: 100px 24px 60px; }
  .ck-page * { box-sizing: border-box; }
  .ck-card { width: 100%; max-width: 1240px; margin: 0 auto; background: #f3ede3; border: 1px solid rgba(120,96,70,0.16); border-radius: 16px; overflow: hidden; }

  /* Header */
  .ck-header { padding: 28px 34px; background: #ece4d7; border-bottom: 1px solid rgba(120,96,70,0.12); }
  .ck-h1 { font-family: "Poppins", sans-serif; font-weight: 700; font-size: 26px; color: #36281c; margin: 0; letter-spacing: -0.4px; }
  .ck-sub { font-size: 14px; color: #8c7d6c; margin: 7px 0 0; }

  /* Body */
  .ck-body { display: grid; grid-template-columns: 310px 1fr 340px; }

  /* Labels */
  .ck-label { display: block; font-family: "Hanken Grotesk", sans-serif; font-weight: 600; font-size: 11px; letter-spacing: 0.8px; text-transform: uppercase; color: #a8957f; margin-bottom: 7px; }
  .ck-section-label { font-family: "Hanken Grotesk", sans-serif; font-weight: 600; font-size: 12px; letter-spacing: 1px; text-transform: uppercase; color: #a8957f; margin-bottom: 22px; }
  .ck-req { color: #cf6f1f; }
  .ck-mono { font-family: "Space Mono", monospace; }

  /* Cart */
  .ck-cart { padding: 30px 24px 32px; background: #efe7da; border-right: 1px solid rgba(120,96,70,0.12); }
  .ck-items { display: flex; flex-direction: column; gap: 22px; padding-bottom: 24px; border-bottom: 1px solid rgba(120,96,70,0.12); }
  .ck-item { display: flex; align-items: center; gap: 14px; }
  .ck-thumb { flex: none; width: 56px; height: 56px; border-radius: 12px; background: #e3d8c6; display: grid; place-items: center; color: #9a7f5f; }
  .ck-item-info { flex: 1; min-width: 0; }
  .ck-item-name { font-family: "Poppins", sans-serif; font-weight: 600; font-size: 14px; color: #36281c; }
  .ck-item-price { font-family: "Space Mono", monospace; font-size: 11px; color: #a8957f; margin-top: 2px; }

  .ck-stepper { display: flex; align-items: center; gap: 6px; background: #fbf8f2; border: 1px solid rgba(120,96,70,0.18); border-radius: 999px; padding: 3px; }
  .ck-step-btn { all: unset; cursor: pointer; width: 22px; height: 22px; display: grid; place-items: center; border-radius: 50%; transition: background 160ms; }
  .ck-step-minus { color: #8a7565; }
  .ck-step-minus:hover { background: rgba(120,96,70,0.1); }
  .ck-step-plus { background: #cf6f1f; color: #fff7ec; }
  .ck-step-plus:hover { background: #b85f15; }
  .ck-qty { font-family: "Space Mono", monospace; font-weight: 700; font-size: 13px; color: #36281c; min-width: 14px; text-align: center; }

  .ck-summary { margin-top: 24px; display: flex; flex-direction: column; gap: 13px; }
  .ck-sum-row { display: flex; justify-content: space-between; align-items: baseline; font-size: 14px; color: #7a6a58; }
  .ck-strong { color: #4a3a2a; }
  .ck-envio { font-size: 13px; color: #a8957f; }
  .ck-total-row { display: flex; justify-content: space-between; align-items: baseline; padding-top: 14px; margin-top: 4px; border-top: 1px solid rgba(120,96,70,0.12); }
  .ck-total-label { font-family: "Poppins", sans-serif; font-weight: 700; font-size: 16px; color: #36281c; }
  .ck-total-igv { font-family: "Space Mono", monospace; font-size: 10px; color: #a8957f; letter-spacing: 0.5px; }
  .ck-total-amt { font-family: "Poppins", sans-serif; font-weight: 800; font-size: 24px; color: #c2691c; }

  /* Form */
  .ck-form { padding: 30px 30px 34px; }
  .ck-h2 { font-family: "Poppins", sans-serif; font-weight: 700; font-size: 19px; color: #36281c; margin: 0 0 8px; letter-spacing: -0.2px; }
  .ck-form-note { font-size: 13.5px; line-height: 1.55; color: #8c7d6c; margin: 0 0 24px; max-width: 560px; }
  .ck-block { margin-bottom: 20px; }
  .ck-grid-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 14px; margin-bottom: 16px; }
  .ck-grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 16px; }
  .ck-mb-lg { margin-bottom: 24px; }
  .ck-mb-md { margin-bottom: 16px; }
  .ck-field { display: block; }

  .ck-input { width: 100%; box-sizing: border-box; font-family: "Hanken Grotesk", sans-serif; font-size: 14px; color: #4a3a2a; background: #fbf8f2; border: 1px solid rgba(120,96,70,0.2); border-radius: 10px; padding: 11px 13px; outline: none; transition: border-color 160ms; }
  .ck-input:focus { border-color: #cf6f1f; }
  .ck-input::placeholder { color: #b6a48f; }

  /* Segmented */
  .ck-seg { display: inline-flex; flex-wrap: wrap; gap: 6px; background: #ece4d7; border-radius: 12px; padding: 5px; }
  .ck-seg-btn { all: unset; cursor: pointer; white-space: nowrap; font-size: 13.5px; font-weight: 600; padding: 9px 18px; border-radius: 8px; color: #8a7565; transition: background 180ms, color 180ms; }
  .ck-seg-wide { padding: 9px 26px; }
  .ck-seg-btn.is-active { background: #cf6f1f; color: #fff7ec; }

  /* Dropdowns */
  .ck-dd { position: relative; }
  .ck-dd-trigger { all: unset; cursor: pointer; box-sizing: border-box; width: 100%; display: flex; align-items: center; justify-content: space-between; gap: 8px; font-family: "Hanken Grotesk", sans-serif; font-size: 14px; color: #4a3a2a; background: #fbf8f2; border: 1px solid rgba(120,96,70,0.2); border-radius: 10px; padding: 11px 13px; transition: border-color 160ms; }
  .ck-dd-value { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .ck-dd-value.is-placeholder { color: #b6a48f; }
  .ck-dd-chev { flex: none; transition: transform 200ms; }
  .ck-dd.is-open .ck-dd-trigger { border-color: #cf6f1f; }
  .ck-dd.is-open .ck-dd-chev { transform: rotate(180deg); }
  .ck-dd.is-disabled .ck-dd-trigger { background: #efe9df; cursor: not-allowed; }
  .ck-dd.is-disabled .ck-dd-value.is-placeholder { color: #c4b9a8; }

  .ck-dd-panel { display: none; position: absolute; left: 0; right: 0; top: calc(100% + 6px); z-index: 30; max-height: 240px; overflow-y: auto; background: #fbf8f2; border: 1px solid #cf6f1f; border-radius: 10px; padding: 5px; }
  .ck-dd.is-open .ck-dd-panel { display: block; }
  .ck-dd-opt { all: unset; cursor: pointer; box-sizing: border-box; display: block; width: 100%; font-family: "Hanken Grotesk", sans-serif; font-size: 13.5px; color: #4a3a2a; padding: 8px 11px; border-radius: 7px; transition: background 130ms; }
  .ck-dd-opt:hover { background: #f0e3d3; }
  .ck-dd-opt.is-selected { background: #f4e2cf; color: #c2691c; }

  .ck-comprobante { padding-top: 22px; border-top: 1px solid rgba(120,96,70,0.12); }
  .ck-obligatorio { font-family: "Space Mono", monospace; font-size: 11px; color: #b3a48f; margin-top: 14px; }

  /* Payment column (previously footer) */
  .ck-payment { padding: 30px 24px 32px; background: #efe7da; border-left: 1px solid rgba(120,96,70,0.12); }
  .ck-foot-head { display: flex; flex-direction: column; gap: 4px; margin-bottom: 20px; }
  .ck-foot-title { font-family: "Poppins", sans-serif; font-weight: 700; font-size: 15px; color: #36281c; }
  .ck-foot-total { font-family: "Poppins", sans-serif; font-weight: 800; font-size: 24px; color: #c2691c; }

  .ck-pay { display: flex; flex-direction: column; gap: 18px; }
  .ck-pay-methods { display: flex; flex-direction: column; gap: 10px; width: 100%; }
  .ck-pay-method { all: unset; cursor: pointer; box-sizing: border-box; display: flex; align-items: center; gap: 11px; padding: 12px 14px; border-radius: 12px; background: transparent; border: 1.5px solid rgba(120,96,70,0.2); transition: background 160ms, border-color 160ms; }
  .ck-pay-method.is-active { background: #fff7ee; border-color: #cf6f1f; }
  .ck-radio { width: 22px; height: 22px; border-radius: 50%; border: 2px solid rgba(120,96,70,0.35); display: grid; place-items: center; transition: border-color 160ms; }
  .ck-pay-method.is-active .ck-radio { border-color: #cf6f1f; }
  .ck-radio-dot { width: 10px; height: 10px; border-radius: 50%; background: transparent; transition: background 160ms; }
  .ck-pay-method.is-active .ck-radio-dot { background: #cf6f1f; }
  .ck-pay-name { font-family: "Poppins", sans-serif; font-weight: 600; font-size: 14px; color: #36281c; }

  .ck-info { width: 100%; display: flex; align-items: center; gap: 14px; background: #fbf8f2; border: 1px solid rgba(120,96,70,0.16); border-radius: 14px; padding: 14px 16px; }
  .ck-info-text { flex: 1; min-width: 0; }
  .ck-info-block { display: flex; flex-direction: column; gap: 4px; }
  .ck-info-block[hidden] { display: none; }
  .ck-info-eyebrow { font-family: "Space Mono", monospace; font-size: 10px; letter-spacing: 1.5px; text-transform: uppercase; color: #a8957f; }
  .ck-info-main { font-family: "Poppins", sans-serif; font-weight: 700; font-size: 18px; color: #36281c; letter-spacing: 0.5px; }
  .ck-info-sub { font-size: 12.5px; color: #8c7d6c; line-height: 1.3; }
  .ck-qr { flex: none; width: 72px; height: 72px; border-radius: 10px; background: #fff; border: 1px solid rgba(120,96,70,0.16); display: grid; place-items: center; }
  .ck-qr[hidden] { display: none; }

  .ck-actions { display: flex; flex-direction: column; gap: 10px; width: 100%; }
  .ck-attach { all: unset; cursor: pointer; box-sizing: border-box; display: inline-flex; align-items: center; justify-content: center; gap: 9px; font-family: "Hanken Grotesk", sans-serif; font-weight: 600; font-size: 14px; color: #6f5e4c; background: #fbf8f2; border: 1.5px dashed rgba(120,96,70,0.35); padding: 11px 20px; border-radius: 12px; transition: border-color 160ms, color 160ms; }
  .ck-attach:hover { border-color: #cf6f1f; color: #cf6f1f; }
  .ck-buy { all: unset; cursor: pointer; box-sizing: border-box; display: inline-flex; align-items: center; justify-content: center; gap: 10px; font-family: "Poppins", sans-serif; font-weight: 700; font-size: 15px; color: #fff7ec; background: #cf6f1f; padding: 14px 28px; border-radius: 12px; transition: background 180ms; }
  .ck-buy:hover { background: #b85f15; }

  @media (max-width: 990px) {
    .ck-body { grid-template-columns: 1fr; }
