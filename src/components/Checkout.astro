  interface CheckoutState {
    qty: Record<string, number>;
    ship: string;
    doc: string;
    pay: string;
    dep: string;
    prov: string;
    dist: string;
    open: string;
    [key: string]: any;
  }

  function initCheckout(root: HTMLElement) {
    // precios desde el markup
    const prices: Record<string, number> = {};
    root.querySelectorAll('.ck-item').forEach((item) => {
      const htmlItem = item as HTMLElement;
      const qtyEl = htmlItem.querySelector('[data-qty]') as HTMLElement;
      if (!qtyEl) return;
      const id = qtyEl.dataset.qty || '';
      const priceEl = htmlItem.querySelector('.ck-item-price');
      const txt = priceEl ? priceEl.textContent || '' : '';
      const m = txt.match(/(\d[\d.]*)/);
      prices[id] = m ? parseFloat(m[1]) : 0;
    });

    const money = (n: number) => 'S/. ' + n.toFixed(2);
    const state: CheckoutState = { qty: {}, ship: 'delivery', doc: 'boleta', pay: 'yape', dep: '', prov: '', dist: '', open: '' };
    
    root.querySelectorAll('[data-qty]').forEach((el) => {
      const htmlEl = el as HTMLElement;
      state.qty[htmlEl.dataset.qty || ''] = parseInt(htmlEl.textContent || '0', 10) || 0;
    });

    // ---- Totales ----
    function renderTotals() {
      let sub = 0, count = 0;
      Object.keys(state.qty).forEach((id) => {
        sub += (prices[id] || 0) * (state.qty[id] || 0);
        count += state.qty[id] || 0;
      });
      root.querySelectorAll('[data-qty]').forEach((el) => {
        const htmlEl = el as HTMLElement;
        htmlEl.textContent = String(state.qty[htmlEl.dataset.qty || ''] || 0);
      });
      const countEl = root.querySelector('[data-count]');
      if (countEl) countEl.textContent = String(count);
      const subEl = root.querySelector('[data-subtotal]');
      if (subEl) subEl.textContent = money(sub);
      root.querySelectorAll('[data-total]').forEach((el) => {
        el.textContent = money(sub);
      });
    }

    root.querySelectorAll('.ck-step-btn').forEach((btn) => {
      const htmlBtn = btn as HTMLElement;
      htmlBtn.addEventListener('click', () => {
        const id = htmlBtn.dataset.item || '';
        if (htmlBtn.dataset.act === 'inc') {
          state.qty[id] = (state.qty[id] || 0) + 1;
        } else {
          state.qty[id] = Math.max(0, (state.qty[id] || 0) - 1);
        }
        renderTotals();
      });
    });

    // ---- Envío ----
    root.querySelectorAll('[data-ship]').forEach((btn) => {
      const htmlBtn = btn as HTMLElement;
      htmlBtn.addEventListener('click', () => {
        state.ship = htmlBtn.dataset.ship || '';
        root.querySelectorAll('[data-ship]').forEach((b) => b.classList.toggle('is-active', b === htmlBtn));
        const envio = root.querySelector('[data-envio]');
        if (envio) envio.textContent = state.ship === 'delivery' ? 'Gratis en Lima' : 'Por Shalom · por pagar';
      });
    });

    // ---- Comprobante ----
    root.querySelectorAll('[data-doc]').forEach((btn) => {
      const htmlBtn = btn as HTMLElement;
      htmlBtn.addEventListener('click', () => {
        state.doc = htmlBtn.dataset.doc || '';
        root.querySelectorAll('[data-doc]').forEach((b) => b.classList.toggle('is-active', b === htmlBtn));
        const lbl = root.querySelector('[data-doc-label]');
        const idLbl = root.querySelector('[data-doc-id-label]');
        if (lbl) lbl.innerHTML = (state.doc === 'factura' ? 'Razón social' : 'Nombre y apellido') + ' <span class="ck-req">*</span>';
        if (idLbl) idLbl.innerHTML = (state.doc === 'factura' ? 'RUC' : 'DNI') + ' <span class="ck-req">*</span>';
      });
    });

    // ---- Pago ----
    root.querySelectorAll('[data-pay]').forEach((btn) => {
      const htmlBtn = btn as HTMLElement;
      htmlBtn.addEventListener('click', () => {
        state.pay = htmlBtn.dataset.pay || '';
        root.querySelectorAll('[data-pay]').forEach((b) => b.classList.toggle('is-active', b === htmlBtn));
        root.querySelectorAll('[data-info]').forEach((el) => {
          const htmlEl = el as HTMLElement;
          htmlEl.hidden = htmlEl.dataset.info !== state.pay;
        });
        const qr = root.querySelector('[data-qr]') as HTMLElement;
        if (qr) qr.hidden = state.pay !== 'yape';
      });
    });

    // ---- Dropdowns en cascada ----
    const dds: Record<string, HTMLElement> = {};
    root.querySelectorAll('[data-dd]').forEach((dd) => {
      const htmlDd = dd as HTMLElement;
      dds[htmlDd.dataset.dd || ''] = htmlDd;
    });

    function optionsFor(which: string): string[] {
      if (which === 'dep') return Object.keys(PERU);
      if (which === 'prov') return state.dep ? Object.keys(PERU[state.dep as keyof typeof PERU]) : [];
      if (which === 'dist') {
        const depData = PERU[state.dep as keyof typeof PERU];
        return (state.dep && state.prov && depData && depData[state.prov as keyof typeof depData])
          ? depData[state.prov as keyof typeof depData]
          : [];
      }
      return [];
    }

    function placeholderFor(which: string): string {
      if (which === 'dep') return 'Selecciona departamento';
      if (which === 'prov') return state.dep ? 'Selecciona provincia' : 'Elige departamento';
      return state.prov ? 'Selecciona distrito' : 'Elige provincia';
    }

    function pick(which: string, value: string) {
      if (which === 'dep') { state.dep = value; state.prov = ''; state.dist = ''; }
      else if (which === 'prov') { state.prov = value; state.dist = ''; }
      else { state.dist = value; }
      state.open = '';
      renderDD();
    }

    function renderDD() {
      ['dep', 'prov', 'dist'].forEach((which) => {
        const dd = dds[which];
        if (!dd) return;
        const enabled = which === 'dep' || (which === 'prov' && !!state.dep) || (which === 'dist' && !!state.prov);
        const selected = state[which];
        const valueEl = dd.querySelector('.ck-dd-value') as HTMLElement;
        const panel = dd.querySelector('.ck-dd-panel') as HTMLElement;
        if (!valueEl || !panel) return;

        dd.classList.toggle('is-disabled', !enabled);
        dd.classList.toggle('is-open', state.open === which && enabled);

        if (selected) {
          valueEl.textContent = selected;
          valueEl.classList.remove('is-placeholder');
        } else {
          valueEl.textContent = placeholderFor(which);
          valueEl.classList.add('is-placeholder');
        }

        panel.innerHTML = '';
        optionsFor(which).forEach((opt) => {
          const b = document.createElement('button');
          b.type = 'button';
          b.className = 'ck-dd-opt' + (opt === selected ? ' is-selected' : '');
          b.textContent = opt;
          b.addEventListener('click', (e) => { e.stopPropagation(); pick(which, opt); });
          panel.appendChild(b);
        });
      });
    }

    root.querySelectorAll('[data-dd] .ck-dd-trigger').forEach((trigger) => {
      const htmlTrigger = trigger as HTMLElement;
      htmlTrigger.addEventListener('click', (e) => {
        e.stopPropagation();
        const ddParent = htmlTrigger.closest('[data-dd]') as HTMLElement;
        if (!ddParent) return;
        const which = ddParent.dataset.dd || '';
        const enabled = which === 'dep' || (which === 'prov' && !!state.dep) || (which === 'dist' && !!state.prov);
        if (!enabled) return;
        state.open = state.open === which ? '' : which;
        renderDD();
      });
    });

    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (state.open && target && (!target.closest || !target.closest('[data-dd]'))) {
        state.open = '';
        renderDD();
      }
    });

    renderTotals();
    renderDD();
  }

  document.querySelectorAll('.ck-page').forEach((el) => initCheckout(el as HTMLElement));
</script>
