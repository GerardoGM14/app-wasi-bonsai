---
// Footer.astro — Footer Wasi Bonsai con modales legales
// Uso: import Footer from "../components/Footer.astro"; luego <Footer />
//
// Fuentes: carga Poppins, Hanken Grotesk y Space Mono desde Google Fonts.
// Si ya las cargas en tu Layout, borra el bloque <link> de abajo.
//
// Los textos legales son de ejemplo — reemplázalos con los definitivos.
// El formulario del Libro de reclamaciones es una maqueta; conéctalo a tu backend.

interface SocialLink {
  label: string;
  href: string;
}

interface Props {
  instagram?: string;
  facebook?: string;
  tiktok?: string;
  whatsapp?: string;
  bullets?: string[];
}

const {
  instagram = "https://www.instagram.com/wasibonsai/?hl=es",
  facebook = "https://www.facebook.com/wasibonsai/",
  tiktok = "https://www.tiktok.com/@wasibonsai",
  whatsapp = "https://wa.me/qr/EKZ5LEEOUMBKL1",
  bullets = [
    "Tips de cultivo, diseño y exposición de bonsáis.",
    "Terapia y salud mental con la práctica del bonsái.",
    "Registro de los árboles de tu casa y su evolución.",
    "Y mucho más sobre el mundo del bonsái.",
  ],
} = Astro.props as Props;
---

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Poppins:wght@500;600;700;800&family=Hanken+Grotesk:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap"
  rel="stylesheet"
/>

<footer class="wb">
  <div class="wb-inner">
    <div class="wb-cols">
      <!-- Comunidad / social -->
      <div class="wb-col wb-col--community">
        <div class="wb-eyebrow">
          <span class="wb-eyebrow-line"></span>
          <span class="wb-eyebrow-text">Comunidad</span>
        </div>
        <h3 class="wb-title">¡Únete a la comunidad!</h3>
        <p class="wb-lead">
          Comparte tu colección, aprende del cuidado del bonsái y conecta con
          otros cultivadores.
        </p>

        <div class="wb-social">
          <a
            href={instagram}
            class="wb-social-btn"
            aria-label="Instagram"
            target="_blank"
            rel="noopener"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0C8.74 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.051C.014 8.333 0 8.74 0 12s.014 3.667.072 4.947c.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.74 24 12 24s3.667-.014 4.948-.072c4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.26-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.667.014 15.26 0 12 0zm0 5.838a6.162 6.162 0 1 1 0 12.324 6.162 6.162 0 0 1 0-12.324zM12 16a4 4 0 1 0 0-8 4 4 0 0 0 0 8zm6.406-11.845a1.44 1.44 0 1 1 0 2.881 1.44 1.44 0 0 1 0-2.881z"/>
            </svg>
          </a>
          <a
            href={facebook}
            class="wb-social-btn"
            aria-label="Facebook"
            target="_blank"
            rel="noopener"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <path d="M9.101 23.691v-9.502H6.14V10.66h2.961V7.745c0-2.937 1.793-4.533 4.409-4.533 1.253 0 2.332.093 2.646.135v3.07h-1.817c-1.425 0-1.7.677-1.7 1.67v2.186h3.398l-.443 3.529h-2.955v9.502H9.101z"/>
            </svg>
          </a>
          <a
            href={tiktok}
            class="wb-social-btn"
            aria-label="TikTok"
            target="_blank"
            rel="noopener"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.02 1.63 4.18 1.09 1.14 2.58 1.83 4.14 1.95v3.66c-1.74-.08-3.43-.68-4.85-1.72-.11-.08-.22-.17-.32-.26v6.49c0 2.22-.88 4.35-2.45 5.92-1.57 1.57-3.7 2.45-5.92 2.45S4.35 21.79 2.78 20.22C1.21 18.65.33 16.52.33 14.3s.88-4.35 2.45-5.92c1.57-1.57 3.7-2.45 5.92-2.45.64 0 1.28.08 1.9.23v3.7c-.61-.26-1.27-.39-1.93-.38-1.22.01-2.39.5-3.25 1.36-.86.86-1.35 2.03-1.36 3.25 0 1.22.49 2.39 1.36 3.25.86.86 2.03 1.35 3.25 1.36 1.21 0 2.37-.48 3.24-1.34.87-.86 1.36-2.02 1.37-3.23.02-3.89.01-7.78.02-11.67-.01-.08 0-.16.01-.24z"/>
            </svg>
          </a>
          <a
            href={whatsapp}
            class="wb-social-btn"
            aria-label="WhatsApp"
            target="_blank"
            rel="noopener"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2a10 10 0 0 0-8.6 15l-1.3 4.7 4.8-1.3A10 10 0 1 0 12 2zm0 18a8 8 0 0 1-4.1-1.1l-.3-.2-2.8.8.8-2.8-.2-.3A8 8 0 1 1 12 20zm4.5-5.9c-.2-.1-1.4-.7-1.7-.8s-.4-.1-.6.1-.6.8-.8 1-.3.2-.5.1a6.5 6.5 0 0 1-3.2-2.8c-.2-.4.2-.4.6-1.2a.4.4 0 0 0 0-.4l-.8-1.9c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.6 4c2 .8 2 .5 2.4.5a2.6 2.6 0 0 0 1.7-1.2 2.1 2.1 0 0 0 .1-1.2c0-.1-.2-.2-.5-.3z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Síguenos para conocer más -->
      <div class="wb-col">
        <p class="wb-list-title">Síguenos para conocer más sobre:</p>
        <ul class="wb-list">
          {
            bullets.map((b) => (
              <li class="wb-list-item">
                <span class="wb-dot" />
                {b}
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="wb-bottom">
      <nav class="wb-legal">
        <button type="button" class="wb-legal-link" data-modal="tc"
          >Términos y condiciones</button
        >
        <button type="button" class="wb-legal-link" data-modal="pp"
          >Política de privacidad y cookies</button
        >
        <button type="button" class="wb-legal-link wb-legal-link--disabled"
          >Libro de reclamaciones</button
        >
      </nav>
      <p class="wb-copy">
        © {new Date().getFullYear()} · WasiBonsai · Hecho por Trigra
      </p>
    </div>
  </div>

  <!-- Modales legales -->
  <div class="wb-overlay" data-overlay hidden>
    <!-- Términos y condiciones -->
    <div class="wb-modal" data-panel="tc" hidden>
      <div class="wb-modal-head">
        <div>
          <h3 class="wb-modal-title">Términos y condiciones</h3>
        </div>
        <button
          type="button"
          class="wb-modal-close"
          data-close
          aria-label="Cerrar"
        >
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"></path></svg
          >
        </button>
      </div>
      <div class="wb-modal-body">
        <p>
          <strong>PRIMERO: Condiciones Generales.</strong><br />
          Al navegar en nuestra página web, el usuario acepta las condiciones que
          se establecen a continuación, manifestando su total conformidad con
          éstas, por lo que solicitamos leer con detención los términos y
          condiciones que rigen el uso de nuestra Web, junto con los alcances de
          los servicios que por medio de la misma se proveen. El presente
          instrumento regula el uso de la página web Wasi Bonsai, sitio Web de
          propiedad de Jesús Francisco Iparraguirre Moreno con RUC: 10764709522.
        </p>
        <p>
          <strong>SEGUNDO: Definiciones.</strong><br />
          Para los propósitos del presente instrumento, los siguientes términos
          tendrán el significado que en la presente cláusula se establecen:<br />
          a) Usuario: Persona natural que visita la página web de Wasi Bonsai,
          ya sea navegando por las distintas secciones o adquiriendo un producto.<br />
          b) Titular de los datos: Es el sujeto que registra sus datos en alguna
          sección de la página Web de Wasi Bonsai.<br />
          c) WasiBonsai.pe: Plataforma Web de la marca Wasi Bonsai.
        </p>
        <p>
          <strong>TERCERO: Antecedentes Previos.</strong><br />
          WasiBonsai.pe sirve como canal informativo de nuestros productos y/o
          servicios, así como canal de venta directo para realizar un pedido. Por
          otra parte, WasiBonsai.pe almacena información básica de contacto del
          Usuario. Toda la información entregada por el Usuario es almacenada por
          WasiBonsai bajo las más estrictas medidas de seguridad. WasiBonsai.pe
          no permite el acceso de terceros a sus servidores.
        </p>
        <p>
          <strong>CUARTO: Condiciones de Uso de la Plataforma Web de WasiBonsai</strong><br />
          Los servicios de WasiBonsai.pe están disponibles sólo para aquellos
          individuos que tengan capacidad legal para contratar, según lo
          dispuesto por la legislación vigente. Si una persona no tiene capacidad
          legal para contratar, debe abstenerse de utilizar los servicios
          ofrecidos en la Plataforma.<br />
          El Usuario de WasiBonsai.pe se compromete a hacer uso de la misma con
          fines exclusivamente personales. WasiBonsai.pe tiene por fin poner a
          disposición de sus Usuarios, productos especializados para Bonsai y
          jardinería en general. El Usuario de WasiBonsai.pe no podrá hacer uso
          de la misma con fines ilícitos, que lesionen derechos e intereses de
          WasiBonsai, terceros, o que de cualquier forma puedan dañar,
          inutilizar, sobrecargar, deteriorar o impedir la normal utilización de
          esta Plataforma Web, los equipos informáticos o los documentos, archivos
          y toda clase de contenidos almacenados en cualquier equipo informático de
          WasiBonsai. Especialmente se considerará conductas contrarias a las
          presentes políticas de uso de WasiBonsai.pe, sin ser esta lista
          exhaustiva o taxativa, la extracción automática de información de la
          Plataforma Web, copia de la información alojada en la Plataforma Web
          para usos no establecidos en el presente instrumento y la reventa a
          terceros de la información obtenida desde la Plataforma Web.<br />
          La infracción de las condiciones de uso de WasiBonsai.pe, por parte de
          un Usuario, implicará la imposibilidad de brindarle el servicio por
          tiempo indefinido y la eliminación de toda la información relacionada a
          dicho Usuario. WasiBonsai.pe hace expresa reserva de las acciones
          legales que estime pertinentes para los casos de infracción el presente
          contrato o de la ley.
        </p>
        <p>
          <strong>QUINTO: Propiedad intelectual.</strong><br />
          WasiBonsai.pe contiene material registrado, marcas, patentes, logos y
          propiedad intelectual e industrial de propiedad de WasiBonsai,
          asimismo incluyendo, sin ser esta lista exhaustiva, información, texto,
          software, diseños, dibujos, fotos y gráficas (en adelante el
          “Contenido”). Tanto el Contenido de WasiBonsai.pe, como la
          organización, disposición, arreglo y diseño de los elementos presentes
          en la misma y en cada una de sus páginas, son propiedad de WasiBonsai
          (o son materiales respecto de los cuales WasiBonsai cuenta con los
          permisos y/o licencias de los titulares de derechos) y están
          protegidas por derechos de propiedad intelectual e industrial. El
          Usuario reconoce que no adquiere ningún derecho sobre los Contenidos. La
          información descargada de WasiBonsai.pe, puede ser utilizada por el
          Usuario, según lo descrito en estas Condiciones de Uso, pero es de
          propiedad exclusiva de WasiBonsai. La marca “WasiBonsai” es una marca
          registrada y vigente.<br />
          WasiBonsai se reserva todos los derechos de propiedad intelectual e
          industrial que le correspondan sobre el Producto.
        </p>
        <p>
          <strong>SEXTO: Medios de Pagos, Comprobantes de Pago y Condiciones de Venta.</strong><br />
          Todo Usuario, para adquirir los distintos productos ofrecidos en
          WasiBonsai.pe deberá aportar un medio de pago válido, de los
          permitidos en dicha Plataforma Web (Transferencia Bancaria, Yape o
          plin). En cuanto al pago mediante transferencia, se puede realizar a
          nuestras cuentas en el banco BCP, Yape y Plin funcionan de igual manera.<br />
          Todo pago, ya sea por transferencia, yape o plin; deberá ser verificado
          adjuntando el comprobante de pago en el formulario de compra al hacer
          su pedido. Toda compra requiere el voucher de pago adjunto en el
          formulario para poder ser completada.<br />
          Para cualquiera de los dos medios de pago provistos, la transacción
          quedará sujeta a la verificación por parte de la entidad bancaria. No se
          considerará como completa una transacción mientras WasiBonsai.pe no
          reciba la autorización del banco respectiva. En caso que WasiBonsai no
          reciba dicha confirmación, se anulará la compra.<br />
          WasiBonsai emitirá el comprobante de pago solicitado por el Usuario,
          pudiendo este ser Boleta o Factura, en función a lo que le permita
          emitir su condición tributaria. Es responsabilidad del Usuario elegir el
          tipo de comprobante a elegir y consignar correctamente los datos
          solicitados para la emisión del comprobante de pago (Nombre completo y
          Dirección en caso de una Boleta; RUC, Razón Social y Dirección Fiscal
          en caso de una Factura).
        </p>
        <p>
          <strong>SETIMO: Despachos y condiciones de entrega.</strong><br />
          Una vez completada la transacción de compra, se reenviará el formulario
          de compra y el comprobante de pago al correo electrónico y número de
          Whatsapp del usuario. WasiBonsai hará los mayores esfuerzos por entregar
          los productos lo antes posible, en los plazos y costos estipulados.<br />
          Los horarios de entrega son de 8 am a 8 pm y se podrá coordinar un
          rango más preciso mediante el contacto de Whatsapp de WasiBonsai. Es
          responsabilidad del Usuario que los datos relativos al despacho sean
          correctamente proporcionados. Será responsabilidad del Usuario informar
          el cambio del domicilio proporcionado por éste al momento de la compra,
          en el tiempo que media entre la compra y la entrega del producto.<br />
          Al momento de la entrega del producto, es responsabilidad del Usuario
          revisar que éste venga en óptimas condiciones y sin adulteraciones. Será
          responsabilidad del Usuario que los datos relativos a la dirección de
          despacho, proporcionados en la WasiBonsai.pe, sean correctos.
          Igualmente, se deberá de encontrar una persona mayor de edad presente en
          el domicilio al momento de realizar la entrega. Deberá proporcionar para
          recibir el paquete un documento de identidad que lo identifique y firmar
          el cargo de recepción.<br />
          Se realizarán un máximo de 2 intentos de entrega al cliente, durante el
          horario de entrega, siempre coordinando con él la misma. El segundo
          intento de entrega no conlleva un costo adicional. En caso el cliente
          no reciba el producto tras 2 intentos de entrega, el paquete será
          devuelto a las oficinas de WasiBonsai y será responsabilidad del cliente
          recogerlo o coordinar una nueva entrega, pagando los costos asociados.
        </p>
        <p>
          Si por razones de caso fortuito o fuerza mayor WasiBonsai se ve
          imposibilitada de poder despachar determinados productos, se le
          comunicará al Usuario que la entrega no podrá realizarse y procederá a
          realizar la devolución del dinero a través del mismo medio por el cual
          el Usuario realizó el pago (transferencia bancaria, yape o plin).
          WasiBonsai se compromete con gestionar el extorno en un plazo máximo de
          5 días hábiles (Lunes a Viernes). El plazo para la devolución del dinero
          en la cuenta bancaria del Usuario o de dependerá de las condiciones
          contractuales de cada banco y de la entidad procesadora de pagos,
          pudiendo esto tomar hasta 30 días hábiles.
        </p>
        <p>
          <strong>OCTAVO: Descuentos y Promociones.</strong><br />
          Los descuentos y promociones disponibles en la WasiBonsai.pe aplican
          sólo para compras realizadas exitosamente en dicha Plataforma Web. Cuando
          se trate de promociones, se mostrará el stock disponible y duración de
          los descuentos, que tendrán un tiempo limitado y, no reflejan los
          precios disponibles en otros canales de venta.
        </p>
        <p>
          <strong>NOVENO: Obligaciones del Usuario.</strong><br />
          El Usuario será responsable de la veracidad de los datos entregados a
          WasiBonsai, así como también de la actualización o modificación de los
          mismos. El Usuario será responsable, asimismo, de poner en conocimiento
          de WasiBonsai en el menor tiempo posible, cualquier uso de la
          información almacenada por esta última fuera del ámbito del presente
          contrato de que tenga conocimiento.
        </p>
        <p>
          <strong>DÉCIMO: Servicio al Usuario.</strong><br />
          WasiBonsai pone a disposición de sus Usuarios un servicio de ayuda, con
          el fin de contestar todas las dudas que éstos puedan tener sobre las
          Políticas de Uso de la Plataforma Web y solucionar cualquier problema
          con la venta de los productos ofrecidos por WasiBonsai. Los
          consumidores pueden hacer uso del servicio enviando un correo
          electrónico a la dirección: jassus2008@gmail.com
        </p>
        <p>
          <strong>DÉCIMO PRIMERO: Resolución.</strong><br />
          WasiBonsai podrá dejar sin efecto la orden de compra previo aviso escrito
          si: 1) el Precio no es pagado puntualmente, a cuyo efecto las partes
          pactan expresamente que la falta de pago total o parcial producirá la
          rescisión de pleno derecho; o 2) Ud. incumple con cualesquiera de las
          obligaciones asumidas en este documento. WasiBonsai podrá optar por
          exigir la ejecución de su obligación de pagar el precio y en cualquier
          caso exigir resarcimiento de daños y perjuicios.
        </p>
        <p>
          <strong>DÉCIMO SEGUNDO: Jurisdicción.</strong><br />
          Este documento queda sometido a las leyes de la República de Perú.
          Cualquier controversia se someterá a los tribunales del Cercado de Lima
          y tanto WasiBonsai como el Usuario renuncian expresamente a cualquier
          otro fuero que pudiera corresponderles en razón de su domicilio
          presente o futuro.
        </p>
        <p>
          <strong>DÉCIMO TERCERO: Varios.</strong><br />
          Si cualquier disposición en este documento fuese declarada inválida o
          inaplicable por un Tribunal el resto de las mismas no se verá afectado.
          Ud. no puede ceder a ningún tercero, cualesquiera de las obligaciones o
          derechos a su cargo salvo aprobación previa y por escrito de
          WasiBonsai. WasiBonsai podrá ceder cualesquiera de las obligaciones o
          derechos a su cargo a cualquier filial, sucursal, casa matriz o tercero
          por razones de negocio. Las notificaciones deben hacerse por escrito (a
          mano, por e-mail, fax o correo certificado) y enviadas al representante
          legal de la otra parte.
        </p>
      </div>
    </div>

    <!-- Política de privacidad -->
    <div class="wb-modal" data-panel="pp" hidden>
      <div class="wb-modal-head">
        <div>
          <h3 class="wb-modal-title">Política de privacidad y cookies</h3>
        </div>
        <button
          type="button"
          class="wb-modal-close"
          data-close
          aria-label="Cerrar"
        >
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"></path></svg
          >
        </button>
      </div>
      <div class="wb-modal-body">
        <p>
          En Wasi Bonsai, respetamos y protegemos tus datos personales, conforme a lo dispuesto por la Ley N° 29733 – Ley de Protección de Datos Personales y su reglamento.
        </p>

        <h4>¿Qué datos recopilamos?</h4>
        <p>
          Recolectamos únicamente los datos necesarios para procesar tus pedidos y brindar un mejor servicio:
        </p>
        <ul>
          <li>Nombre completo</li>
          <li>RUC (Si desea factura)</li>
          <li>Dirección de envío</li>
          <li>Número de contacto</li>
          <li>Correo electrónico</li>
        </ul>

        <h4>Finalidad del tratamiento de datos</h4>
        <p>
          Utilizamos tus datos personales exclusivamente para:
        </p>
        <ul>
          <li>Gestionar y coordinar el despacho de tu pedido a domicilio</li>
          <li>Comunicarnos contigo respecto al estado de tu compra</li>
          <li>Enviarte contenido promocional y novedades de Bonsai Pro (solo si nos autorizas expresamente)</li>
        </ul>

        <h4>Confidencialidad y seguridad</h4>
        <p>
          Nos comprometemos a mantener tus datos bajo estricta confidencialidad. Contamos con medidas de seguridad técnicas y organizativas para evitar el acceso no autorizado, pérdida o modificación de tu información.
        </p>
 
        <h4>Cesión de datos</h4>
        <p>
          Wasi Bonsai no vende, alquila ni transfiere tus datos personales a terceros. Solo serán compartidos con proveedores logísticos exclusivamente para fines de entrega, bajo acuerdo de confidencialidad.
        </p>

        <h4>Derechos del titular de los datos</h4>
        <p>
          Puedes ejercer en cualquier momento tus derechos de acceso, rectificación, cancelación y oposición; escribiéndonos al correo <a href="mailto:jassus2008@gmail.com">jassus2008@gmail.com</a>, indicando tu nombre completo y el motivo de la solicitud.
        </p>

        <h4>Aceptación de la política</h4>
        <p>
          Al ingresar tus datos en nuestra página, aceptas voluntariamente el tratamiento de tu información según los términos establecidos en esta política.
        </p>

        <h3 class="wb-modal-title" style="font-size: 18px; margin: 28px 0 12px; border-top: 1px solid rgba(120, 96, 70, 0.12); padding-top: 20px;">POLÍTICA DE COOKIES</h3>

        <p>
          En Wasi Bonsai usamos cookies para mejorar tu experiencia en nuestro sitio web. Al continuar navegando, aceptas el uso de estas tecnologías según los términos que te explicamos a continuación.
        </p>
 
        <h4>¿Qué son las cookies?</h4>
        <p>
          Las cookies son pequeños archivos de texto que se almacenan en tu navegador cuando visitas una página web. Nos permiten reconocerte en futuras visitas y ofrecerte una mejor experiencia.
        </p>

