---
// Footer.astro — Footer Wasi Bonsai con modales legales
// Uso: import Footer from "../components/Footer.astro"; luego <Footer />
//
// Fuentes: carga Poppins, Hanken Grotesk y Space Mono desde Google Fonts.
// Si ya las cargas en tu Layout, borra el bloque <link> de abajo.
//
// Los textos legales son de ejemplo — reemplázalos con los definitivos.
// El formulario del Libro de reclamaciones es una maqueta; conéctalo a tu backend.

interface SocialLink {
  label: string;
  href: string;
}

interface Props {
  instagram?: string;
  facebook?: string;
  tiktok?: string;
  whatsapp?: string;
  bullets?: string[];
}

const {
  instagram = "https://www.instagram.com/wasibonsai/?hl=es",
  facebook = "https://www.facebook.com/wasibonsai/",
  tiktok = "https://www.tiktok.com/@wasibonsai",
  whatsapp = "https://wa.me/qr/EKZ5LEEOUMBKL1",
  bullets = [
    "Tips de cultivo, diseño y exposición de bonsáis.",
    "Terapia y salud mental con la práctica del bonsái.",
    "Registro de los árboles de tu casa y su evolución.",
    "Y mucho más sobre el mundo del bonsái.",
  ],
} = Astro.props as Props;
---

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Poppins:wght@500;600;700;800&family=Hanken+Grotesk:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap"
  rel="stylesheet"
/>

<footer class="wb">
  <div class="wb-inner">
    <div class="wb-cols">
      <!-- Comunidad / social -->
      <div class="wb-col wb-col--community">
        <div class="wb-eyebrow">
          <span class="wb-eyebrow-line"></span>
          <span class="wb-eyebrow-text">Comunidad</span>
        </div>
        <h3 class="wb-title">¡Únete a la comunidad!</h3>
        <p class="wb-lead">
          Comparte tu colección, aprende del cuidado del bonsái y conecta con
          otros cultivadores.
        </p>

        <div class="wb-social">
          <a
            href={instagram}
            class="wb-social-btn"
            aria-label="Instagram"
            target="_blank"
            rel="noopener"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0C8.74 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.051C.014 8.333 0 8.74 0 12s.014 3.667.072 4.947c.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.74 24 12 24s3.667-.014 4.948-.072c4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.26-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.667.014 15.26 0 12 0zm0 5.838a6.162 6.162 0 1 1 0 12.324 6.162 6.162 0 0 1 0-12.324zM12 16a4 4 0 1 0 0-8 4 4 0 0 0 0 8zm6.406-11.845a1.44 1.44 0 1 1 0 2.881 1.44 1.44 0 0 1 0-2.881z"/>
            </svg>
          </a>
          <a
            href={facebook}
            class="wb-social-btn"
            aria-label="Facebook"
            target="_blank"
            rel="noopener"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <path d="M9.101 23.691v-9.502H6.14V10.66h2.961V7.745c0-2.937 1.793-4.533 4.409-4.533 1.253 0 2.332.093 2.646.135v3.07h-1.817c-1.425 0-1.7.677-1.7 1.67v2.186h3.398l-.443 3.529h-2.955v9.502H9.101z"/>
            </svg>
          </a>
          <a
            href={tiktok}
            class="wb-social-btn"
            aria-label="TikTok"
            target="_blank"
            rel="noopener"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.02 1.63 4.18 1.09 1.14 2.58 1.83 4.14 1.95v3.66c-1.74-.08-3.43-.68-4.85-1.72-.11-.08-.22-.17-.32-.26v6.49c0 2.22-.88 4.35-2.45 5.92-1.57 1.57-3.7 2.45-5.92 2.45S4.35 21.79 2.78 20.22C1.21 18.65.33 16.52.33 14.3s.88-4.35 2.45-5.92c1.57-1.57 3.7-2.45 5.92-2.45.64 0 1.28.08 1.9.23v3.7c-.61-.26-1.27-.39-1.93-.38-1.22.01-2.39.5-3.25 1.36-.86.86-1.35 2.03-1.36 3.25 0 1.22.49 2.39 1.36 3.25.86.86 2.03 1.35 3.25 1.36 1.21 0 2.37-.48 3.24-1.34.87-.86 1.36-2.02 1.37-3.23.02-3.89.01-7.78.02-11.67-.01-.08 0-.16.01-.24z"/>
            </svg>
          </a>
          <a
            href={whatsapp}
            class="wb-social-btn"
            aria-label="WhatsApp"
            target="_blank"
            rel="noopener"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2a10 10 0 0 0-8.6 15l-1.3 4.7 4.8-1.3A10 10 0 1 0 12 2zm0 18a8 8 0 0 1-4.1-1.1l-.3-.2-2.8.8.8-2.8-.2-.3A8 8 0 1 1 12 20zm4.5-5.9c-.2-.1-1.4-.7-1.7-.8s-.4-.1-.6.1-.6.8-.8 1-.3.2-.5.1a6.5 6.5 0 0 1-3.2-2.8c-.2-.4.2-.4.6-1.2a.4.4 0 0 0 0-.4l-.8-1.9c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.6 4c2 .8 2 .5 2.4.5a2.6 2.6 0 0 0 1.7-1.2 2.1 2.1 0 0 0 .1-1.2c0-.1-.2-.2-.5-.3z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Síguenos para conocer más -->
      <div class="wb-col">
        <p class="wb-list-title">Síguenos para conocer más sobre:</p>
        <ul class="wb-list">
          {
            bullets.map((b) => (
              <li class="wb-list-item">
                <span class="wb-dot" />
                {b}
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="wb-bottom">
      <nav class="wb-legal">
        <button type="button" class="wb-legal-link" data-modal="tc"
          >Términos y condiciones</button
        >
        <button type="button" class="wb-legal-link" data-modal="pp"
          >Política de privacidad y cookies</button
        >
        <button type="button" class="wb-legal-link" data-modal="lr"
          >Libro de reclamaciones</button
        >
      </nav>
      <p class="wb-copy">
        © {new Date().getFullYear()} · WasiBonsai · Hecho por Trigra
      </p>
    </div>
  </div>

  <!-- Modales legales -->
  <div class="wb-overlay" data-overlay hidden>
    <!-- Términos y condiciones -->
    <div class="wb-modal" data-panel="tc" hidden>
      <div class="wb-modal-head">
        <div>
          <div class="wb-modal-eyebrow">Legal</div>
          <h3 class="wb-modal-title">Términos y condiciones</h3>
        </div>
        <button
          type="button"
          class="wb-modal-close"
          data-close
          aria-label="Cerrar"
        >
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"></path></svg
          >
        </button>
      </div>
      <div class="wb-modal-body">
        <p>Texto de ejemplo de términos y condiciones...</p>
      </div>
    </div>

    <!-- Política de privacidad -->
    <div class="wb-modal" data-panel="pp" hidden>
      <div class="wb-modal-head">
        <div>
          <div class="wb-modal-eyebrow">Legal</div>
          <h3 class="wb-modal-title">Política de privacidad y cookies</h3>
        </div>
        <button
          type="button"
          class="wb-modal-close"
          data-close
          aria-label="Cerrar"
        >
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"></path></svg
          >
        </button>
      </div>
      <div class="wb-modal-body">
        <p>Texto de ejemplo de política de privacidad...</p>
      </div>
    </div>

    <!-- Libro de reclamaciones -->
    <div class="wb-modal" data-panel="lr" hidden>
      <div class="wb-modal-head">
        <div>
          <div class="wb-modal-eyebrow">Reclamaciones</div>
          <h3 class="wb-modal-title">Libro de reclamaciones</h3>
        </div>
        <button
          type="button"
          class="wb-modal-close"
          data-close
          aria-label="Cerrar"
        >
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"></path></svg
          >
        </button>
      </div>
      <div class="wb-modal-body">
        <p>
          Déjanos tu reclamo o queja y te responderemos en un plazo máximo de 15
          días hábiles, conforme a la normativa vigente.
        </p>
        <form class="wb-form" onsubmit="return false">
          <div class="wb-form-row">
            <label class="wb-field">
              <span class="wb-field-label">Nombre completo</span>
              <input type="text" name="nombre" />
            </label>
            <label class="wb-field">
              <span class="wb-field-label">Correo</span>
              <input type="email" name="correo" />
            </label>
          </div>
          <label class="wb-field">
            <span class="wb-field-label">Tipo</span>
            <select name="tipo">
              <option>Reclamo</option>
              <option>Queja</option>
            </select>
          </label>
          <label class="wb-field">
            <span class="wb-field-label">Detalle</span>
            <textarea rows="4" name="detalle"></textarea>
          </label>
          <button type="submit" class="wb-submit">Enviar reclamo</button>
        </form>
        <p class="wb-note">
          Formulario de ejemplo — conéctalo a tu sistema de registro.
        </p>
      </div>
    </div>
  </div>
</footer>

<style>
  .wb {
    background: #7a6051;
    padding: 72px 32px 30px;
    font-family: "Hanken Grotesk", system-ui, sans-serif;
  }
  .wb * {
    box-sizing: border-box;
  }
  .wb-inner {
    max-width: 1240px;
    margin: 0 auto;
  }

  .wb-cols {
    display: flex;
    flex-wrap: wrap;
    gap: 56px;
    justify-content: space-between;
    padding-bottom: 52px;
    border-bottom: 1px solid rgba(243, 236, 225, 0.12);
  }
  .wb-col {
    flex: 1;
    min-width: 280px;
    max-width: 460px;
  }
  .wb-col--community {
    min-width: 300px;
  }

  .wb-eyebrow {
    display: flex;
    align-items: center;
    gap: 11px;
    margin-bottom: 16px;
  }
  .wb-eyebrow-line {
    width: 26px;
    height: 2px;
    background: #e0a23a;
  }
  .wb-eyebrow-text {
    font-family: "Space Mono", monospace;
    font-size: 11.5px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: #e0a23a;
  }
  .wb-title {
    font-family: "Poppins", sans-serif;
    font-weight: 700;
    font-size: 23px;
    color: #f4ede2;
    margin: 0 0 12px;
    letter-spacing: -0.3px;
  }
  .wb-lead {
    font-size: 15px;
    line-height: 1.6;
    color: rgba(243, 236, 225, 0.66);
    margin: 0 0 26px;
    max-width: 380px;
  }

  .wb-social {
    display: flex;
    gap: 12px;
  }
  .wb-social-btn {
    width: 48px;
    height: 48px;
    border-radius: 14px;
    display: grid;
    place-items: center;
    background: rgba(243, 236, 225, 0.06);
    border: 1px solid rgba(243, 236, 225, 0.16);
    color: #f4ede2;
    transition: all 200ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .wb-social-btn:hover {
    background: rgba(243, 236, 225, 0.18);
    border-color: rgba(243, 236, 225, 0.5);
    transform: translateY(-3px);
    color: #ffffff;
  }
  .wb-social-btn svg {
    display: block;
    transition: transform 200ms;
  }
  .wb-social-btn[aria-label="Facebook"] svg {
    transform: translateY(-1.2px) scale(1.05);
  }
  .wb-social-btn[aria-label="TikTok"] svg {
    transform: translateY(-0.8px) scale(0.92);
  }
  .wb-social-btn[aria-label="WhatsApp"] svg {
    transform: translateY(-1px) scale(1.05);
  }

  .wb-list-title {
    font-family: "Poppins", sans-serif;
    font-weight: 600;
    font-size: 15px;
    color: #f4ede2;
    margin: 0 0 22px;
  }
  .wb-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .wb-list-item {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    font-size: 15px;
    line-height: 1.5;
    color: rgba(243, 236, 225, 0.72);
  }
  .wb-dot {
    flex: none;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #e0a23a;
    margin-top: 7px;
  }

  .wb-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    padding-top: 26px;
  }
  .wb-legal {
    display: flex;
    flex-wrap: wrap;
    gap: 26px;
  }
  .wb-legal-link {
    all: unset;
    cursor: pointer;
    font-family: "Hanken Grotesk", sans-serif;
    font-size: 13.5px;
    color: rgba(243, 236, 225, 0.7);
    transition: color 180ms;
  }
  .wb-legal-link:hover {
    color: #e0a23a;
  }
  .wb-copy {
    font-family: "Hanken Grotesk", system-ui, sans-serif;
    font-size: 13.5px;
    color: rgba(243, 236, 225, 0.5);
    margin: 0;
  }

  /* Modales */
  .wb-overlay {
    position: fixed;
    inset: 0;
    z-index: 60;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    background: rgba(28, 20, 12, 0.62);
    backdrop-filter: blur(6px);
    animation: wbScrimIn 200ms ease;
  }
  .wb-overlay[hidden] {
    display: none;
  }

  .wb-modal {
    position: relative;
    width: 100%;
    max-width: 640px;
    max-height: 84vh;
    overflow-y: auto;
    background: #f6f1e8;
    border-radius: 22px;
    box-shadow: 0 36px 90px rgba(0, 0, 0, 0.5);
    animation: wbModalIn 300ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .wb-modal[hidden] {
    display: none;
  }

  .wb-modal-head {
    position: sticky;
    top: 0;
    background: #f6f1e8;
    padding: 28px 32px 18px;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 18px;
    border-bottom: 1px solid rgba(120, 96, 70, 0.12);
  }
  .wb-modal-eyebrow {
    font-family: "Space Mono", monospace;
    font-size: 11px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: #b06a33;
    margin-bottom: 8px;
  }
  .wb-modal-title {
    font-family: "Poppins", sans-serif;
    font-weight: 700;
    font-size: 22px;
    color: #36281c;
    margin: 0;
    letter-spacing: -0.3px;
  }
  .wb-modal-close {
    all: unset;
    cursor: pointer;
    flex: none;
    width: 36px;
    height: 36px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: rgba(120, 96, 70, 0.1);
    color: #6f5e4c;
    transition: background 180ms;
  }
  .wb-modal-close:hover {
    background: rgba(120, 96, 70, 0.2);
  }

  .wb-modal-body {
    padding: 22px 32px 32px;
    color: #6f5e4c;
    font-size: 14.5px;
    line-height: 1.72;
  }
  .wb-modal-body p {
    margin: 0 0 18px;
  }
  .wb-modal-body h4 {
    font-family: "Poppins", sans-serif;
    font-weight: 600;
    font-size: 15px;
    color: #36281c;
    margin: 0 0 8px;
  }
  .wb-note {
    font-family: "Space Mono", monospace;
    font-size: 12px;
    color: #a08a6f;
    margin: 24px 0 0 !important;
  }

  /* Formulario */
  .wb-form {
    margin-top: 4px;
  }
  .wb-form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-bottom: 16px;
  }
  .wb-field {
    display: block;
    margin-bottom: 16px;
  }
  .wb-form-row .wb-field {
    margin-bottom: 0;
  }
  .wb-field-label {
    display: block;
    font-family: "Space Mono", monospace;
    font-size: 11px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: #a08a6f;
    margin-bottom: 7px;
  }
  .wb-field input,
  .wb-field select,
  .wb-field textarea {
    width: 100%;
    box-sizing: border-box;
    font-family: "Hanken Grotesk", sans-serif;
    font-size: 14.5px;
    color: #4a3a2a;
    background: #fffdf9;
    border: 1px solid rgba(120, 96, 70, 0.2);
    border-radius: 10px;
    padding: 11px 14px;
    outline: none;
    transition:
      border-color 160ms,
      box-shadow 160ms;
  }
  .wb-field textarea {
    resize: vertical;
  }
  .wb-field input:focus,
  .wb-field select:focus,
  .wb-field textarea:focus {
    border-color: rgba(207, 111, 31, 0.5);
    box-shadow: 0 0 0 3px rgba(207, 111, 31, 0.12);
  }
  .wb-submit {
    all: unset;
    cursor: pointer;
    box-sizing: border-box;
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-family: "Poppins", sans-serif;
    font-weight: 600;
    font-size: 14.5px;
    color: #fff7ec;
    background: linear-gradient(135deg, #e89a2a, #cf6f1f);
    padding: 13px 26px;
    border-radius: 12px;
    box-shadow: 0 10px 24px rgba(207, 111, 31, 0.32);
    transition:
      transform 180ms,
      box-shadow 180ms;
  }
  .wb-submit:hover {
    transform: translateY(-2px);
    box-shadow: 0 14px 30px rgba(207, 111, 31, 0.42);
  }

  @keyframes wbScrimIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  @keyframes wbModalIn {
    from {
      opacity: 0;
      transform: translateY(16px) scale(0.98);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @media (max-width: 560px) {
    .wb-form-row {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .wb-form-row .wb-field {
      margin-bottom: 16px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wb-social-btn,
    .wb-submit,
    .wb-overlay,
    .wb-modal {
      animation: none;
      transition: none;
    }
  }
</style>

<script>
  function initFooter(root: HTMLElement) {
    const overlay = root.querySelector<HTMLElement>("[data-overlay]");
    const panels = Array.from(
      root.querySelectorAll<HTMLElement>("[data-panel]"),
    );
    const triggers = Array.from(
      root.querySelectorAll<HTMLButtonElement>("[data-modal]"),
    );
    if (!overlay) return;
    const activeOverlay = overlay;

    function openModal(key: string) {
      panels.forEach((p) => (p.hidden = p.dataset.panel !== key));
      activeOverlay.hidden = false;
      document.body.style.overflow = "hidden";
    }
    function closeModal() {
      activeOverlay.hidden = true;
      panels.forEach((p) => (p.hidden = true));
      document.body.style.overflow = "";
    }

    triggers.forEach((t) =>
      t.addEventListener("click", () => openModal(t.dataset.modal || "")),
    );
    root
      .querySelectorAll("[data-close]")
      .forEach((c) => c.addEventListener("click", closeModal));
    activeOverlay.addEventListener("click", (e) => {
      if (e.target === activeOverlay) closeModal();
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !activeOverlay.hidden) closeModal();
    });
  }

  document.querySelectorAll<HTMLElement>(".wb").forEach((el) => initFooter(el));
</script>
