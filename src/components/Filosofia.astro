---
// Filosofia.astro — Sección de filosofía / cita (full-bleed) Wasi Bonsai
// Uso: import Filosofia from "../components/Filosofia.astro"; luego <Filosofia />
//
// Fuentes: carga Poppins, Hanken Grotesk y Space Mono desde Google Fonts.
// Si ya las cargas en tu Layout, borra el bloque <link> de abajo.

import { Image } from "astro:assets";
import logoWasiBonsai from "../assets/icons/icono-wasibonsai.svg";

interface Props {
  eyebrow?: string;
  quote?: string;
  body?: string;
  brand?: string;
  tagline?: string;
}

const {
  eyebrow = "Filosofía Wasi",
  quote = "Cuida un bonsái, y cultivarás tu espíritu.",
  body = "La práctica del bonsái es más que un pasatiempo: es una terapia que alimenta la constancia, la dedicación y la conexión con uno mismo. Cada poda, cada riego y cada trasplante es un recordatorio de que las cosas valiosas crecen con paciencia.",
  brand = "WASI BONSAI",
  tagline = "Pre-bonsáis y material de trabajo"
} = Astro.props as Props;
---

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Poppins:wght@500;600;700;800&family=Hanken+Grotesk:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap"
  rel="stylesheet"
/>

<section class="fil">
  <svg class="fil-leaf fil-leaf--1" width="180" height="180" viewBox="0 0 24 24" fill="#fff" aria-hidden="true"><path d="M17 8C8 10 5.9 16.17 3.82 21.34l1.06.66C7 18 9 17 12 16c5-2 7-7 5-12-3 0-5 1-6 2-1.5 1.5-2 3-2 5 0 .5 0 1 .1 1.5C9 12 9 9 11 7c1-1 3-2 6-2 0 0 1 3 0 3z"/></svg>
  <svg class="fil-leaf fil-leaf--2" width="150" height="150" viewBox="0 0 24 24" fill="#fff" aria-hidden="true"><path d="M17 8C8 10 5.9 16.17 3.82 21.34l1.06.66C7 18 9 17 12 16c5-2 7-7 5-12-3 0-5 1-6 2-1.5 1.5-2 3-2 5 0 .5 0 1 .1 1.5C9 12 9 9 11 7c1-1 3-2 6-2 0 0 1 3 0 3z"/></svg>

  <div class="fil-inner">
    <div class="fil-text">

      <h2 class="fil-quote"><span class="fil-mark">&ldquo;</span>{quote}</h2>
      <p class="fil-body">{body}</p>
    </div>

    <div class="fil-brand">
      <Image src={logoWasiBonsai} alt="Wasi Bonsai Logo" class="fil-brand-img" />
    </div>
  </div>
</section>

<style>
  .fil {
    position: relative;
    overflow: hidden;
    background: linear-gradient(108deg, #e6ac70 0%, #c47f3e 38%, #8a4f22 74%, #593016 100%);
    font-family: "Hanken Grotesk", system-ui, sans-serif;
  }
  .fil * { box-sizing: border-box; }

  .fil-leaf { position: absolute; pointer-events: none; }
  .fil-leaf--1 { top: -28px; right: 38%; opacity: 0.1; transform: rotate(18deg); }
  .fil-leaf--2 { bottom: -34px; left: 30%; opacity: 0.08; transform: rotate(-150deg); }

  .fil-inner {
    position: relative;
    max-width: 1240px;
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 60px;
    padding: 108px 40px;
  }

  .fil-text { flex: 1; min-width: 320px; max-width: 620px; }



  .fil-quote {
    font-family: "Poppins", sans-serif;
    font-weight: 700;
    font-size: 42px;
    line-height: 1.15;
    color: #fff;
    margin: 0 0 22px;
    letter-spacing: -0.6px;
    text-wrap: balance;
  }
  .fil-mark {
    font-weight: 800;
    color: rgba(255, 255, 255, 0.55);
    margin-right: 4px;
  }
  .fil-body {
    font-size: 17.5px;
    line-height: 1.65;
    color: rgba(255, 247, 238, 0.92);
    margin: 0;
    max-width: 580px;
  }

  .fil-brand {
    flex: none;
    display: flex;
    align-items: center;
  }
  .fil-brand-img {
    width: 220px;
    height: auto;
  }

  @media (max-width: 720px) {
    .fil-inner { padding: 72px 24px; gap: 40px; }
    .fil-quote { font-size: 32px; }
    .fil-body { font-size: 16px; }
  }
</style>
