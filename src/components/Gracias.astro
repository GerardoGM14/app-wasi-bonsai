---
// Gracias.astro — Pantalla de confirmación "¡Gracias por tu compra!" Wasi Bonsai
// Uso: import Gracias from "../components/Gracias.astro"; luego <Gracias />
//
// Fuentes: carga Poppins, Hanken Grotesk y Space Mono desde Google Fonts.
// Si ya las cargas en tu Layout, borra el bloque <link> de abajo.

interface Props {
  whatsappUrl?: string;
  instagramUrl?: string;
  facebookUrl?: string;
  bullets?: string[];
}

const {
  whatsappUrl = "#",
  instagramUrl = "#",
  facebookUrl = "#",
  bullets = [
    "Tips de cultivo, diseño y exposición de bonsáis.",
    "Terapia y salud mental con la práctica del bonsái.",
    "Registro de los árboles de tu casa y su evolución.",
    "Y mucho más sobre el mundo del bonsái…"
  ]
} = Astro.props as Props;
---

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Poppins:wght@500;600;700;800&family=Hanken+Grotesk:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap"
  rel="stylesheet"
/>

<div class="gr-page">
  <div class="gr-card">
    <!-- Close -->
    <button type="button" class="gr-close" aria-label="Cerrar" data-gracias-close>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
    </button>

    <!-- Hero -->
    <div class="gr-hero">
      <div class="gr-mark">
        <svg width="54" height="54" viewBox="0 0 64 64" fill="none" aria-hidden="true">
          <circle cx="22" cy="17" r="7.5" fill="#cdb139"/>
          <circle cx="40" cy="20" r="11" fill="#b9701f"/>
          <circle cx="27" cy="24" r="8.5" fill="#cf7d23"/>
          <circle cx="48" cy="27" r="7" fill="#a35c18"/>
          <path d="M33 44 C33 44 32 34 30 29" stroke="#7a4a1c" stroke-width="3" stroke-linecap="round"/>
          <path d="M33 44 C33 44 35 36 39 31" stroke="#7a4a1c" stroke-width="3" stroke-linecap="round"/>
          <path d="M33 38 C33 38 28 35 24 35" stroke="#7a4a1c" stroke-width="2.4" stroke-linecap="round"/>
          <path d="M24 50 C24 47 42 47 42 50 L40 55 C40 56 26 56 26 55 Z" fill="#9a571c"/>
          <rect x="22" y="44" width="22" height="4" rx="2" fill="#7a4a1c"/>
        </svg>
      </div>

      <h1 class="gr-title">¡Gracias por tu compra!</h1>
      <p class="gr-lead">En breve te enviaremos tu comprobante de pago por WhatsApp y coordinaremos por ahí la entrega de tu pedido. También puedes escribirnos haciendo <a href={whatsappUrl} class="gr-link">click aquí</a>.</p>
    </div>

    <!-- Divider -->
    <div class="gr-divider">
      <span class="gr-divider-line"></span>
      <span class="gr-divider-text">Comunidad</span>
      <span class="gr-divider-line"></span>
    </div>

    <!-- Community -->
    <div class="gr-community">
      <h2 class="gr-community-title">¡Únete a la comunidad!</h2>

      <div class="gr-social">
        <a href={instagramUrl} class="gr-social-btn" aria-label="Instagram" target="_blank" rel="noopener">
          <svg width="25" height="25" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5.5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.6" cy="6.4" r="1.1" fill="currentColor" stroke="none"/></svg>
        </a>
        <a href={facebookUrl} class="gr-social-btn" aria-label="Facebook" target="_blank" rel="noopener">
          <svg width="25" height="25" viewBox="0 0 24 24" fill="currentColor"><path d="M14 9h2.5V6H14c-2 0-3.5 1.5-3.5 3.5V11H8v3h2.5v7h3v-7H16l.5-3h-3V9.7c0-.5.3-.7.8-.7z"/></svg>
        </a>
      </div>

      <p class="gr-follow">Síguenos en redes sociales para conocer más sobre:</p>

      <ul class="gr-list">
        {bullets.map((b) => (
          <li class="gr-list-item"><span class="gr-dot"></span>{b}</li>
        ))}
      </ul>
    </div>
  </div>
</div>

<style>
  .gr-page {
    min-height: 100%;
    background: #e7ddcf;
    font-family: "Hanken Grotesk", system-ui, sans-serif;
    padding: 90px 24px 48px;
    display: flex;
    align-items: flex-start;
    justify-content: center;
  }
  .gr-page * { box-sizing: border-box; }

  .gr-card {
    position: relative;
    width: 100%;
    max-width: 720px;
    background: #ece3d8;
    border: 1px solid rgba(120, 96, 70, 0.16);
    border-radius: 18px;
    padding: 56px 56px 54px;
  }

  .gr-close {
    all: unset;
    cursor: pointer;
    position: absolute;
    top: 20px;
    right: 20px;
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    color: #6f5e4c;
    transition: background 180ms;
  }
  .gr-close:hover { background: rgba(120, 96, 70, 0.12); }

  .gr-hero { display: flex; flex-direction: column; align-items: center; text-align: center; }
  .gr-mark {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    background: #e3d6c5;
    display: grid;
    place-items: center;
    margin-bottom: 22px;
  }
  .gr-title {
    font-family: "Poppins", sans-serif;
    font-weight: 700;
    font-size: 34px;
    color: #a0691c;
    margin: 0 0 16px;
    letter-spacing: -0.6px;
  }
  .gr-lead {
    font-size: 16px;
    line-height: 1.65;
    color: #897a6a;
    margin: 0;
    max-width: 500px;
  }
  .gr-link {
    color: #cf6f1f;
    font-weight: 700;
    text-decoration: none;
    border-bottom: 1.5px solid rgba(207, 111, 31, 0.35);
    transition: border-color 180ms;
  }
  .gr-link:hover { border-color: #cf6f1f; }

  .gr-divider { display: flex; align-items: center; gap: 16px; margin: 40px 0 34px; }
  .gr-divider-line { flex: 1; height: 1px; background: rgba(120, 96, 70, 0.14); }
  .gr-divider-text {
    font-family: "Space Mono", monospace;
    font-size: 10.5px;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: #b3a08a;
  }

  .gr-community { text-align: center; }
  .gr-community-title {
    font-family: "Poppins", sans-serif;
    font-weight: 700;
    font-size: 21px;
    color: #a0691c;
    margin: 0 0 20px;
    letter-spacing: -0.3px;
  }

  .gr-social { display: flex; justify-content: center; gap: 14px; margin-bottom: 32px; }
  .gr-social-btn {
    width: 54px;
    height: 54px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: #9a571c;
    color: #fbf3e9;
    transition: transform 200ms cubic-bezier(0.16, 1, 0.3, 1), background 200ms;
  }
  .gr-social-btn:hover { background: #cf6f1f; transform: translateY(-3px); }

  .gr-follow {
    font-family: "Poppins", sans-serif;
    font-weight: 600;
    font-size: 15px;
    color: #5d4836;
    margin: 0 0 18px;
  }

  .gr-list {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    display: inline-flex;
    flex-direction: column;
    gap: 12px;
    text-align: left;
  }
  .gr-list-item {
    display: flex;
    align-items: flex-start;
    gap: 13px;
    font-size: 15px;
    line-height: 1.45;
    color: #897a6a;
  }
  .gr-dot { flex: none; width: 6px; height: 6px; border-radius: 50%; background: #cf6f1f; margin-top: 8px; }

  @media (max-width: 560px) {
    .gr-card { padding: 48px 26px 44px; }
    .gr-title { font-size: 28px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .gr-social-btn, .gr-close, .gr-link { transition: none; }
  }
</style>

<script>
  document.querySelectorAll('[data-gracias-close]').forEach((btn) => {
    btn.addEventListener('click', () => {
      window.location.href = '/';
    });
  });
</script>
