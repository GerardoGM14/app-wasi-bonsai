---
import { Image } from "astro:assets";
import imgTransplante from "../assets/images/transplante.png";
import imgMantenimiento from "../assets/images/mantenimiento.png";
import imgMaceta from "../assets/images/maceta.png";
import imgDecorativo from "../assets/images/decorativo.png";

interface Step {
  n: string;
  title: string;
  desc: string;
  img: any;
  alt: string;
}

interface Props {
  /** Texto del eyebrow superior. Por defecto "Guía de uso · 04 escenarios". */
  eyebrow?: string;
  /** Pasos a mostrar. Cuatro por defecto. */
  steps?: Step[];
}

const {
  eyebrow = 'Guía de uso · 04 escenarios',
  steps = [
    {
      n: '01',
      title: 'Transplantes',
      desc: 'Cambio de maceta y renovación de sustrato sin estresar las raíces.',
      img: imgTransplante,
      alt: 'Bolsa de sustrato BonsaiPro junto a un bonsái listo para transplante',
    },
    {
      n: '02',
      title: 'Mantenimiento',
      desc: 'Drenaje y aireación óptimos para el cuidado periódico de tu bonsái.',
      img: imgMantenimiento,
      alt: 'Aplicación de sustrato BonsaiPro a un bonsái en maceta',
    },
    {
      n: '03',
      title: 'Toda planta en maceta',
      desc: 'Suculentas, ornamentales y de interior — un sustrato para todas.',
      img: imgMaceta,
      alt: 'Variedad de plantas y suculentas en macetas',
    },
    {
      n: '04',
      title: 'Decorativo',
      desc: 'Acabado limpio sobre la superficie, ideal para arreglos a la vista.',
      img: imgDecorativo,
      alt: 'Bonsái con raíces expuestas siendo trasplantado',
    },
  ],
} = Astro.props as Props;
---

<section id="como-usar" class="bp-section" aria-labelledby="bp-title">
  <div class="bp-inner">
    <h2 id="bp-title" class="bp-h1">
      ¿Cómo usar <span class="accent">BonsaiPro</span>?
    </h2>
    <p class="bp-lead">
      Sea que necesites trasplantar tus árboles, o mejorar la calidad del sustrato;
      con <strong>BonsaiPro</strong> siempre tendrás las mejores condiciones para un
      crecimiento óptimo.
    </p>

    <ul class="cards" role="list">
      {steps.map((s) => (
        <li class="card">
          <Image class="card-img" src={s.img} alt={s.alt} />
          <div class="overlay" aria-hidden="true"></div>
          <div class="body">
            <span class="step">Paso {s.n}</span>
            <h3 class="title">{s.title}</h3>
            <p class="desc">{s.desc}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  /* === Paleta original BonsaiPro ===
     Fondo  : #dcd2c7   (taupe cálido)
     Marrón : #3d2a18   (titulares)
     Ámbar  : #a8701f   (acento "BonsaiPro")
     Texto  : #6b574a   (cuerpo)
  */
  .bp-section {
    background: #E1D7D1; /* Adaptado al color de fondo de la web */
    padding: 100px 24px 70px;
    color: #6b574a;
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
  }
  .bp-inner {
    max-width: 1280px;
    margin: 0 auto;
  }

  .bp-eyebrow {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #a8701f;
    font-weight: 500;
    margin: 0 0 12px;
  }
  .bp-h1 {
    font-family: 'Inter Tight', 'Inter', sans-serif;
    font-weight: 700;
    font-size: clamp(1.6rem, 2.2vw + 1rem, 2rem);
    color: #3d2a18;
    letter-spacing: -0.01em;
    margin: 0 0 14px;
  }
  .bp-h1 .accent { color: #a8701f; }

  .bp-lead {
    max-width: 720px;
    margin: 0;
    font-size: 15.5px;
    line-height: 1.55;
    color: #6b574a;
    text-wrap: pretty;
  }
  .bp-lead strong { color: #3d2a18; font-weight: 600; }

  .cards {
    list-style: none;
    padding: 0;
    margin: 44px 0 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 22px;
  }
  @media (max-width: 900px) {
    .cards { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 520px) {
    .cards { grid-template-columns: 1fr; }
  }

  .card {
    position: relative;
    border-radius: 18px;
    overflow: hidden;
    aspect-ratio: 3 / 4.4;
    cursor: pointer;
    background-color: #7A6051; /* Placeholder fallback */
    transition:
      transform 0.35s cubic-bezier(.2,.7,.2,1),
      box-shadow 0.35s ease;
    box-shadow:
      0 1px 2px rgba(61,42,24,0.05),
      0 8px 22px rgba(61,42,24,0.06);
  }
  .card:hover,
  .card:focus-within {
    transform: translateY(-6px);
    box-shadow:
      0 2px 4px rgba(61,42,24,0.08),
      0 18px 36px rgba(61,42,24,0.14);
  }

  .card-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s cubic-bezier(.2,.7,.2,1);
  }
  .card:hover .card-img,
  .card:focus-within .card-img {
    transform: scale(1.06);
  }

  .overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(255, 255, 255, 0) 0%,
      rgba(185, 168, 157, 0.33) 62%,
      rgba(140, 111, 93, 1) 100%
    );
    pointer-events: none;
  }

  .body {
    position: absolute;
    left: 18px;
    right: 18px;
    bottom: 18px;
    color: #fff;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .step {
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.78);
  }
  .title {
    font-family: 'Inter Tight', 'Inter', sans-serif;
    font-weight: 600;
    font-size: 19px;
    line-height: 1.15;
    letter-spacing: -0.005em;
    margin: 0;
  }
  .desc {
    margin: 0;
    font-size: 12.5px;
    line-height: 1.45;
    color: rgba(255,255,255,0.82);
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    transition:
      max-height 0.4s ease,
      opacity 0.3s ease,
      margin-top 0.4s ease;
  }
  .card:hover .desc,
  .card:focus-within .desc {
    max-height: 80px;
    opacity: 1;
    margin-top: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .card,
    .card-img,
    .desc { transition: none; }
  }
</style>
