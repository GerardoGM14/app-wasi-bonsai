---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import heroImage from "../assets/images/background-wasibonsai.webp";
import logoWasi from "../assets/images/logo-wasibonsai.svg";
import iconHojas from "../assets/icons/icon-hojas.png";
import productosGravavolcanica from "../assets/images/productos-gravavolcanica.png";
import iconoRaices from "../assets/icons/icono-raices.svg";
import iconoNutrientes from "../assets/icons/icono-nutrientes.svg";
import iconoCompacto from "../assets/icons/icono-compacto.svg";
import iconoAgua from "../assets/icons/icono-agua.svg";
import iconoPlaga from "../assets/icons/icono-plaga.svg";
import iconCheck from "../assets/icons/icon-check.svg";
import iconFlechaIzq from "../assets/icons/icono-flecha-izquierda.svg";
import iconFlechaDer from "../assets/icons/icono-flecha-derecha.svg";
import iconCompra from "../assets/icons/icono-compra.svg";
import productosGravavolcanicaV1 from "../assets/images/productos-gravavolcanica_v1.png";
---

<Layout title="WasiBonsai | El arte del hogar miniatura">
	<main class="min-h-screen">
		<!-- Navigation Topbar -->
		<nav
			class="fixed top-0 w-full z-50 px-6 py-4 bg-bar border-b border-white/5 shadow-lg"
		>
			<div class="max-w-7xl mx-auto flex justify-between items-center">
				<div class="flex items-center">
					<Image
						src={logoWasi}
						alt="WasiBonsai Logo"
						class="h-8 md:h-10 w-auto"
					/>
				</div>

				{/* Desktop Links */}
				<div
					class="hidden lg:flex gap-10 text-[15px] font-medium items-center text-asap-text"
				>
					<a
						href="#que-es"
						class="hover:text-white transition-colors duration-300 tracking-tight"
						>¿Qué es BonsaiPro?</a
					>
					<a
						href="#beneficios"
						class="hover:text-white transition-colors duration-300 tracking-tight"
						>Beneficios de BonsaiPro</a
					>
					<a
						href="#como-usar"
						class="hover:text-white transition-colors duration-300 tracking-tight"
						>¿Cómo usar BonsaiPro?</a
					>
					<a
						href="#clientes"
						class="hover:text-white transition-colors duration-300 tracking-tight"
						>Nuestros clientes</a
					>
					<button
						class="bg-comprar text-white px-6 md:px-8 py-2.5 rounded-full font-bold hover:-translate-y-1 hover:brightness-110 transition-all duration-300 cursor-pointer text-sm"
					>
						Comprar
					</button>
				</div>

				{/* Mobile Menu Trigger & Comprar Button */}
				<div class="flex lg:hidden items-center gap-4">
					<button
						class="bg-comprar text-white px-5 py-1.5 rounded-full font-bold text-xs"
					>
						Comprar
					</button>
					<button
						id="menu-toggle"
						class="text-asap-text p-1"
						aria-label="Abrir menú"
					>
						<svg
							xmlns="http://www.w3.org/2000/svg"
							fill="none"
							viewBox="0 0 24 24"
							stroke-width="2"
							stroke="currentColor"
							class="w-7 h-7"
						>
							<path
								stroke-linecap="round"
								stroke-linejoin="round"
								d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"
							></path>
						</svg>
					</button>
				</div>
			</div>

			{/* Mobile Menu Overlay */}
			<div
				id="mobile-menu"
				class="hidden fixed inset-0 top-[70px] bg-bar/98 backdrop-blur-xl z-40 flex flex-col p-8 gap-8 text-xl font-bold text-asap-text items-center text-center animate-in fade-in slide-in-from-top-4 duration-300"
			>
				<a
					href="#que-es"
					class="menu-link border-b border-white/5 w-full pb-4"
					>¿Qué es BonsaiPro?</a
				>
				<a
					href="#beneficios"
					class="menu-link border-b border-white/5 w-full pb-4"
					>Beneficios de BonsaiPro</a
				>
				<a
					href="#como-usar"
					class="menu-link border-b border-white/5 w-full pb-4"
					>¿Cómo usar BonsaiPro?</a
				>
				<a href="#clientes" class="menu-link w-full pb-4"
					>Nuestros clientes</a
				>
			</div>
		</nav>

		<script is:inline>
			const btn = document.getElementById("menu-toggle");
			const menu = document.getElementById("mobile-menu");
			const links = document.querySelectorAll(".menu-link");
			btn.onclick = () => menu.classList.toggle("hidden");
			links.forEach(
				(l) => (l.onclick = () => menu.classList.add("hidden")),
			);
		</script>

		<!-- Hero Section -->
		<section
			id="inicio"
			class="relative min-h-screen flex flex-col justify-center pt-20 overflow-hidden"
		>
			<div class="absolute inset-0 z-0">
				<Image
					src={heroImage}
					alt="WasiBonsai Hero"
					class="w-full h-full object-cover object-center brightness-[0.5]"
					loading="eager"
					fetchpriority="high"
					quality={100}
					width={1920}
				/>
				<div
					class="absolute inset-0 bg-gradient-to-r from-[#3D4329]/55 via-[#3D4329]/35 to-[#495424]/45"
				>
				</div>
			</div>

			<div
				class="relative z-10 max-w-7xl mx-auto px-6 pt-12 md:pt-24 flex flex-col items-start w-full"
			>
				<div class="max-w-3xl space-y-8">
					<h1
						class="text-4xl md:text-[44px] font-bold text-[#E1D7D1] leading-tight font-['Asap'] tracking-tight"
					>
						La vida de un árbol <br /> empieza en sus raíces.
					</h1>
					<p
						class="text-lg md:text-xl text-[#E1D7D1] leading-snug font-['Asap'] max-w-xl font-semibold opacity-90"
					>
						Dale a tus bonsáis el mejor sustrato para vivir, <br /> dales
						<span class="font-bold text-[#F3F3F3] whitespace-nowrap"
							>BonsaiPro.</span
						>
					</p>

					<button
						class="bg-comprar text-white px-8 py-2 rounded-full font-bold text-sm md:text-base shadow-xl hover:-translate-y-1 hover:brightness-110 active:scale-95 transition-all duration-300 font-['Asap']"
					>
						Comprar
					</button>
				</div>

				{/* Características Bar */}
				<div class="w-full mt-24 md:mt-40">
					<div class="border-t border-white/20 w-full mb-8"></div>
					<div
						class="grid grid-cols-2 md:grid-cols-5 gap-6 md:gap-4 text-center"
					>
						<div
							class="flex flex-col items-center group cursor-default"
						>
							<p
								class="text-[11px] md:text-sm text-white/80 font-['Asap'] mb-5 h-10 flex items-center leading-tight px-2"
							>
								Fomenta el <br /> crecimiento de raíces
							</p>
							<div
								class="h-10 md:h-14 flex items-center justify-center group-hover:scale-110 transition-transform duration-300"
							>
								<Image
									src={iconoRaices}
									alt="Icono Raíces"
									class="w-10 h-10 md:w-14 md:h-14"
								/>
							</div>
						</div>
						<div
							class="flex flex-col items-center group cursor-default"
						>
							<p
								class="text-[11px] md:text-sm text-white/80 font-['Asap'] mb-5 h-10 flex items-center leading-tight px-2"
							>
								Almacena agua con <br /> nutrientes
							</p>
							<div
								class="h-10 md:h-14 flex items-center justify-center group-hover:scale-110 transition-transform duration-300"
							>
								<Image
									src={iconoNutrientes}
									alt="Icono Nutrientes"
									class="w-10 h-10 md:w-14 md:h-14"
								/>
							</div>
						</div>
						<div
							class="flex flex-col items-center group cursor-default"
						>
							<p
								class="text-[11px] md:text-sm text-white/80 font-['Asap'] mb-5 h-10 flex items-center leading-tight px-2"
							>
								No se compacta ni se <br /> degrada
							</p>
							<div
								class="h-10 md:h-14 flex items-center justify-center group-hover:scale-110 transition-transform duration-300"
							>
								<Image
									src={iconoCompacto}
									alt="Icono Compacto"
									class="w-10 h-10 md:w-14 md:h-14"
								/>
							</div>
						</div>
						<div
							class="flex flex-col items-center group cursor-default"
						>
							<p
								class="text-[11px] md:text-sm text-white/80 font-['Asap'] mb-5 h-10 flex items-center leading-tight px-2"
							>
								Drena el exceso de <br /> agua
							</p>
							<div
								class="h-10 md:h-14 flex items-center justify-center group-hover:scale-110 transition-transform duration-300"
							>
								<Image
									src={iconoAgua}
									alt="Icono Agua"
									class="w-10 h-10 md:w-14 md:h-14"
								/>
							</div>
						</div>
						<div
							class="flex flex-col items-center group cursor-default"
						>
							<p
								class="text-[11px] md:text-sm text-white/80 font-['Asap'] mb-5 h-10 flex items-center leading-tight px-2"
							>
								Previene plagas y <br /> enfermedades
							</p>
							<div
								class="h-10 md:h-14 flex items-center justify-center group-hover:scale-110 transition-transform duration-300"
							>
								<Image
									src={iconoPlaga}
									alt="Icono Plaga"
									class="w-10 h-10 md:w-14 md:h-14"
								/>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Collections Section -->
		<section
			id="coleccion"
			class="pt-46 pb-12 bg-[#E1D7D1] relative overflow-hidden"
		>

			<!-- Decorative Leaves -->
			<Image
				src={iconHojas}
				alt=""
				class="absolute top-0 left-0 w-40 md:w-80 opacity-100 pointer-events-none"
			/>
			<Image
				src={iconHojas}
				alt=""
				class="absolute bottom-0 right-0 w-40 md:w-80 opacity-100 rotate-180 pointer-events-none"
			/>
			<div class="container mx-auto px-6 -mt-20 relative z-10">
				<div class="text-center mb-10 max-w-3xl mx-auto">
					<h2 class="font-['Asap'] tracking-tight leading-tight mb-3">
						<span
							class="text-4xl md:text-5xl font-black text-[#8B5000] block mb-2"
							>BonsaiPro</span
						>
						<span class="text-2xl md:text-3xl block">
							<span class="font-semibold text-[#7A6051]"
								>Diseñado para cultivar bonsáis</span
							>
							<span class="font-bold text-[#8B5000]"
								>de alta calidad</span
							>
						</span>
					</h2>
					<p
						class="text-lg md:text-xl text-[#7A6051] font-normal leading-snug"
					>
						Sustrato a base de roca volcánica, el mejor componente
						para que tus árboles crezcan fuertes y tengan un
						desarrollo saludable.
					</p>
				</div>

				<div class="relative mt-4">
					<button
						id="prev-slide"
						class="absolute -left-4 lg:-left-16 top-[30%] -translate-y-1/2 z-20 cursor-pointer hover:scale-110 transition-transform active:scale-95 disabled:opacity-30 disabled:cursor-not-allowed"
						aria-label="Anterior"
					>
						<Image
							src={iconFlechaIzq}
							alt=""
							class="w-10 h-10 md:w-12 md:h-12"
						/>
					</button>

					<div class="overflow-hidden -mb-24 pb-24">
						<div id="carousel-track" class="flex transition-transform duration-500 ease-out">
							<!-- Slide 1 -->
							<div class="w-full flex-shrink-0 pb-24">
								<div class="grid grid-cols-1 md:grid-cols-[1.1fr_0.9fr] gap-8 items-center max-w-6xl mx-auto px-4">

						<div class="w-full">
							<Image
								src={productosGravavolcanica}
								alt="Productos Grava Volcánica"
								class="w-full h-auto transition-transform duration-500 hover:scale-105"
							/>
						</div>
						<div
							class="w-full aspect-square md:aspect-auto md:h-[420px] bg-[#7A6051] rounded-3xl p-8 md:p-10 pt-6 md:pt-8 flex flex-col justify-start border border-white/10 relative group"
						>
							<div class="relative z-10">
								<h3
									class="text-[#FFFFFF] text-3xl md:text-4xl font-bold mb-1"
								>
									PROMO 3X2
								</h3>
								<p
									class="text-[#E9E1DC] text-lg md:text-xl mb-4 font-medium"
								>
									Lleva 3 unidades, paga solo:
								</p>

								<div class="flex items-baseline gap-4 mb-4">
									<span
										class="text-[#FFFFFF] text-4xl md:text-5xl font-bold"
										>S/. 38</span
									>
									<span
										class="text-[#FFCA84] text-2xl md:text-3xl line-through decoration-2 opacity-90"
										>S/. 57</span
									>
								</div>

								<ul class="space-y-2">
									<li
										class="flex items-start gap-4 text-[#E9E1DC] text-lg"
									>
										<Image
											src={iconCheck}
											alt=""
											class="w-6 h-6 mt-1 shrink-0"
										/>
										<span
											>Mezcla <strong
												class="font-bold text-white"
												>lista para usar</strong
											></span
										>
									</li>
									<li
										class="flex items-start gap-4 text-[#E9E1DC] text-lg"
									>
										<Image
											src={iconCheck}
											alt=""
											class="w-6 h-6 mt-1 shrink-0"
										/>
										<span
											><strong
												class="font-bold text-white"
												>Cierre hermético</strong
											> para un uso cómodo</span
										>
									</li>
									<li
										class="flex items-start gap-4 text-[#E9E1DC] text-lg"
									>
										<Image
											src={iconCheck}
											alt=""
											class="w-6 h-6 mt-1 shrink-0"
										/>
										<span
											><strong
												class="font-bold text-white"
												>5 litros</strong
											> de rendimiento por bolsa</span
										>
									</li>
									<li
										class="flex items-start gap-4 text-[#E9E1DC] text-lg"
									>
										<Image
											src={iconCheck}
											alt=""
											class="w-6 h-6 mt-1 shrink-0"
										/>
										<span
											><strong
												class="font-bold text-white"
												>El mejor sustituto</strong
											> del sustrato japonés</span
										>
									</li>
									<li
										class="flex items-start gap-4 text-[#E9E1DC] text-lg"
									>
										<Image
											src={iconCheck}
											alt=""
											class="w-6 h-6 mt-1 shrink-0"
										/>
										<span
											><strong
												class="font-bold text-white"
												>Delivery gratis</strong
											> a distritos seleccionados</span
										>
									</li>
								</ul>

								<!-- Buy Button -->
								<button
									class="absolute -bottom-24 left-1/2 -translate-x-1/2 bg-[#DA7D01] text-white py-4 px-10 rounded-2xl font-semibold text-lg flex items-center justify-center gap-3 shadow-2xl hover:scale-105 transition-all active:scale-95 whitespace-nowrap z-50 cursor-pointer"
								>
									<Image
										src={iconCompra}
										alt=""
										class="w-6 h-auto"
									/>
									<span>Comprar Ahora</span>
								</button>
							</div>
						</div>

								</div>
							</div>

							<!-- Slide 2 (Igualito) -->
							<div class="w-full flex-shrink-0 pb-24">
								<div class="grid grid-cols-1 md:grid-cols-[1.1fr_0.9fr] gap-8 items-center max-w-6xl mx-auto px-4">
									<div class="w-full">
										<Image
											src={productosGravavolcanicaV1}
											alt="Productos Grava Volcánica V1"
											class="w-full h-auto transition-transform duration-500 hover:scale-105"
										/>
									</div>
									<div
										class="w-full aspect-square md:aspect-auto md:h-[420px] bg-[#7A6051] rounded-3xl p-8 md:p-10 pt-6 md:pt-8 flex flex-col justify-start border border-white/10 relative group"
									>
										<div class="relative z-10">
											<h3 class="text-[#FFFFFF] text-3xl md:text-4xl font-bold mb-1">
												BonsaiPro - Und
											</h3>
											<p class="text-[#E9E1DC] text-lg md:text-xl mb-4 font-medium">
												Lleva 3 unidades, paga solo:
											</p>

											<div class="flex items-baseline gap-4 mb-4">
												<span class="text-[#FFFFFF] text-4xl md:text-5xl font-bold">S/. 19</span>
												<span class="text-[#FFCA84] text-2xl md:text-3xl line-through decoration-2 opacity-90">S/. 28</span>
											</div>

											<ul class="space-y-2">
												<li class="flex items-start gap-4 text-[#E9E1DC] text-lg">
													<Image src={iconCheck} alt="" class="w-6 h-6 mt-1 shrink-0" />
													<span>Mezcla <strong class="font-bold text-white">lista para usar</strong></span>
												</li>
												<li class="flex items-start gap-4 text-[#E9E1DC] text-lg">
													<Image src={iconCheck} alt="" class="w-6 h-6 mt-1 shrink-0" />
													<span><strong class="font-bold text-white">Cierre hermético</strong> para un uso cómodo</span>
												</li>
												<li class="flex items-start gap-4 text-[#E9E1DC] text-lg">
													<Image src={iconCheck} alt="" class="w-6 h-6 mt-1 shrink-0" />
													<span><strong class="font-bold text-white">5 litros</strong> de rendimiento por bolsa</span>
												</li>
												<li class="flex items-start gap-4 text-[#E9E1DC] text-lg">
													<Image src={iconCheck} alt="" class="w-6 h-6 mt-1 shrink-0" />
													<span><strong class="font-bold text-white">El mejor sustituto</strong> del sustrato japonés</span>
												</li>
												<li class="flex items-start gap-4 text-[#E9E1DC] text-lg">
													<Image src={iconCheck} alt="" class="w-6 h-6 mt-1 shrink-0" />
													<span><strong class="font-bold text-white">Delivery gratis</strong> a distritos seleccionados</span>
												</li>
											</ul>

											<button class="absolute -bottom-24 left-1/2 -translate-x-1/2 bg-[#DA7D01] text-white py-4 px-10 rounded-2xl font-semibold text-lg flex items-center justify-center gap-3 shadow-2xl hover:scale-105 transition-all active:scale-95 whitespace-nowrap z-50 cursor-pointer">
												<Image src={iconCompra} alt="" class="w-6 h-auto" />
												<span>Comprar Ahora</span>
											</button>
										</div>
									</div>
								</div>
							</div>
						</div>
					</div>
					
					<button
						id="next-slide"
						class="absolute -right-4 lg:-right-16 top-[30%] -translate-y-1/2 z-20 cursor-pointer hover:scale-110 transition-transform active:scale-95"
						aria-label="Siguiente"
					>
						<Image src={iconFlechaDer} alt="" class="w-10 h-10 md:w-12 md:h-12" />
					</button>
				</div>

				<!-- Puntos de paginación -->
				<div class="flex justify-center gap-3 mt-0">
					<button id="dot-0" class="w-4 h-4 rounded-full bg-[#DA7D01] transition-all duration-300 cursor-pointer" aria-label="Ir a slide 1"></button>
					<button id="dot-1" class="w-4 h-4 rounded-full border border-[#7A6051] transition-all duration-300 cursor-pointer" aria-label="Ir a slide 2"></button>
				</div>
			</div>
		</section>

		<script>
			const track = document.getElementById('carousel-track');
			const nextBtn = document.getElementById('next-slide');
			const prevBtn = document.getElementById('prev-slide');
			const dots = [document.getElementById('dot-0'), document.getElementById('dot-1')];
			
			let currentIndex = 0;

			function updateCarousel() {
				if (track) track.style.transform = `translateX(-${currentIndex * 100}%)`;
				
				dots.forEach((dot, index) => {
					if (dot) {
						if (index === currentIndex) {
							dot.classList.add('bg-[#DA7D01]');
							dot.classList.remove('border', 'border-[#7A6051]');
						} else {
							dot.classList.remove('bg-[#DA7D01]');
							dot.classList.add('border', 'border-[#7A6051]');
						}
					}
				});
			}

			if (nextBtn) {
				nextBtn.addEventListener('click', () => {
					currentIndex = (currentIndex + 1) % 2;
					updateCarousel();
				});
			}

			if (prevBtn) {
				prevBtn.addEventListener('click', () => {
					currentIndex = (currentIndex - 1 + 2) % 2;
					updateCarousel();
				});
			}

			dots.forEach((dot, index) => {
				if (dot) {
					dot.addEventListener('click', () => {
						currentIndex = index;
						updateCarousel();
					});
				}
			});
		</script>

		<!-- Why Us Section -->
		<section
			class="py-24 bg-gradient-to-b from-slate-950 to-emerald-950/20"
		>
			<div class="container mx-auto px-6">
				<div class="flex flex-col md:flex-row items-center gap-16">
					<div class="md:w-1/2">
						<div
							class="relative w-full aspect-[4/5] rounded-3xl overflow-hidden shadow-2xl"
						>
							<div class="absolute inset-0 bg-primary opacity-40">
							</div>
							<div
								class="absolute inset-0 flex items-center justify-center border border-white/10 m-4 rounded-2xl"
							>
								<p
									class="text-center italic text-secondary text-2xl font-serif px-8 leading-loose"
								>
									"Un bonsai no es solo un árbol, es un
