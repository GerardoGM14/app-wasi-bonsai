---
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation.astro";
import HeroSection from "../components/HeroSection.astro";
import CollectionsSection from "../components/CollectionsSection.astro";
import WhyUsSection from "../components/WhyUsSection.astro";
import ComoUsarBonsaiPro from "../components/ComoUsarBonsaiPro.astro";
import Testimonios from "../components/Testimonios.astro";
import PreguntasFrecuentes from "../components/PreguntasFrecuentes.astro";
import Filosofia from "../components/Filosofia.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="WasiBonsai | El arte del hogar miniatura">
	<main class="min-h-screen">
		<Navigation />
		<HeroSection />
		<CollectionsSection />
		<WhyUsSection />
		<ComoUsarBonsaiPro />
		<Testimonios />
		<CollectionsSection 
			id="comprar-ahora"
			titleHtml={`
				<span class="text-4xl md:text-5xl font-black text-[#8B5000] block mb-2">No pierdas más años de cultivo</span>
				<span class="text-2xl md:text-3xl block">
					<span class="font-semibold text-[#7A6051]">Empieza hoy la transformación de tus </span>
					<span class="font-bold text-[#8B5000]">bonsáis</span>
				</span>
			`}
		/>
		<PreguntasFrecuentes />
		<Filosofia />
		<Footer />
	</main>
</Layout>
